    {
      "name": "01 - CandleGroups",
      "item": [
        {
          "name": "Bootstrap CandleGroups",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeframes\": [\"1m\", \"5m\"],\n  \"coverageStartTs\": 1700000000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/instruments/{{instrumentId}}/candle-groups/bootstrap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "instruments",
                "{{instrumentId}}",
                "candle-groups",
                "bootstrap"
              ]
            }
          }
        },
        {
          "name": "List CandleGroups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/instruments/{{instrumentId}}/candle-groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "instruments",
                "{{instrumentId}}",
                "candle-groups"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var currentGroupId = pm.environment.get('groupId');",
                  "if (!currentGroupId) {",
                  "    var responseJson = pm.response.json();",
                  "    if (Array.isArray(responseJson) && responseJson.length > 0 && responseJson[0].id) {",
                  "        pm.environment.set('groupId', String(responseJson[0].id));",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Run CandleGroup Once",
          "request": {
            "method": "POST",
            "header": [],
