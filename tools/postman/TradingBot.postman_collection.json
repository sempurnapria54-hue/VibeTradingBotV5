      "item": [
        {
          "name": "Create Exchange",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"OKX\",\n  \"status\": \"ACTIVE\",\n  \"baseUrl\": \"https://www.okx.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/exchanges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "exchanges"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var responseJson = pm.response.json();",
                  "if (responseJson && responseJson.id) {",
                  "    pm.environment.set('exchangeId', String(responseJson.id));",
                  "}"
                ]
              }
            }
          ]
        },
