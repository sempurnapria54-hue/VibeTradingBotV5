<?xml version="1.0" encoding="UTF-8"?>
<!--
  bff — единственная точка входа периметра (docs/architecture/services.md):
  проверка токена, резолв тенанта и роли, проксирование поверхностей
  владельцев и раздача живых данных в браузер.

  Своей базы у него НЕТ и стартеров персистентности здесь нет ни одного:
  персистентного состояния периметр не держит, а кэш членств эфемерен
  (docs/architecture/contracts.md §«Живые данные в браузер»).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>bff</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>bff</name>
    <description>Периметр: контекст тенанта, проксирование, живые данные в браузер</description>

    <properties>
        <java.version>25</java.version>
        <springdoc.version>3.0.0</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <wiremock.version>3.13.1</wiremock.version>
        <!--
          Метка красных ожиданий, изъятая из умолчания прогона: дом довода —
          services/common/platform/pom.xml, свойство того же имени.
          Прогон помеченных:  mvn test -Dtest.excluded.groups=
        -->
        <test.excluded.groups>debt</test.excluded.groups>
    </properties>

    <dependencies>
        <!--
          Формы событий — из общего артефакта: у формы есть читатель на
          другой стороне провода, и вторая её запись у потребителя
          разошлась бы с первой (docs/architecture/services.md §«Общие
          артефакты монорепозитория»).
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Общие формы api-слоя: единый error-DTO — контракт внешней
          поверхности, и его клейм держится единственностью носителя.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>api-model</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
          Общие исполнители периметра: охрана джобы, резолвер актора,
          точки входа отказа доступа, исходящая сервисная идентичность.
          Берётся ИМЕНОВАННО — через @Import на классе приложения.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>platform</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
          Формы сообщений внутренней шины — общий артефакт `common/model/message`:
          конверт события
          и содержимое его классов (docs/architecture/services.md §«Общие
          артефакты монорепозитория»). Слой сообщения отделён от домена и
          от интеграции с внешним (.claude/rules/codestyle.md §«Слой
          сообщения: внутренняя шина»).
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>message-model</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          Проба живости — единственная открытая точка контура
          (docs/rules/api-access-policy.md); без стартера актуатора её не
          существует вовсе, и под не становится готовым никогда.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          RestClient.Builder переехал в отдельный модуль в Boot 4:
          starter-web несёт серверную часть, клиентский автоконфиг — здесь.
          Без него бина строителя нет вовсе, и контекст периметра не
          поднимается: не собираются ни AuthMembershipClient, ни
          OwnerProxyClient, то есть ни резолв контекста, ни пересылка.
          Отсутствие найдено подъёмом чёрного ящика (находка F-1 группы B1,
          .claude/tests/cases/bff.md §«Находки владельцам»): компиляция
          такого дефекта не ловит — бин производит автоконфигурация.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          Перевод содержимого события в форму периметра — маппером, а не
          руками (.claude/rules/codestyle.md §Маппинг).
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!--
          Бин ObjectMapper совместимостным автоконфигом Jackson 2 — как у
          соседних сервисов (.claude/rules/tech-radar.md, записи Jackson).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <!--
          Потребление тем производителей: периметр подписан на темы, у
          которых есть производитель, и раздаёт события в браузер
          (docs/architecture/contracts.md §«Живые данные в браузер»).
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Контур доступа доказывается ТЕСТОМ ПОВЕРХНОСТИ, а не строкой
          правила (docs/rules/api-access-policy.md §«Перечень точек: что
          закрыто и что осталось»); поднять фильтры Security под MockMvc
          без этого модуля нечем.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    
        <!--
          Общая форма пробы вместимости планировщика: у сервиса есть
          ИЗМЕРИТЕЛЬ среди джоб, и вывод размера пула обязан иметь охрану
          (.claude/rules/codestyle.md §Джобы). Scope test — дальше тестового
          пути артефакт не уезжает.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          СУБСТРАТ ЧЁРНОГО ЯЩИКА (уровень 1 шага 12 фазы 2). У периметра он
          состоит из ОДНОГО контейнера — брокера, — и это следствие предмета,
          а не экономия: своей базы у периметра нет ни одной
          (docs/architecture/services/bff.md §«Что держит истиной»), ключей
          площадки он не касается, и хранилище секретов ему не нужно. Первый
          из восьми предметов уровня 1, чей ящик поднимается без базы
          (.claude/tests/cases/bff.md §«Чем достаются выходы»).

          БРОКЕР НУЖЕН ОДНОЙ СТОРОНОЙ — входом: периметр только потребляет и
          не публикует ничего, и записи тем есть ВХОД раздачи в браузер.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Стаб чужой HTTP-поверхности — один механизм на два вида: ШЕСТЬ
          владельцев за периметром и точки провайдера идентичности.
          Затенённый артефакт: его Jetty и Jackson не встречаются с Tomcat и
          Jackson контекста сервиса.
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Метка красных ожиданий вне умолчания прогона — довод у свойства. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- Исполняемый артефакт: без repackage образ сервиса собрать не из чего. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
