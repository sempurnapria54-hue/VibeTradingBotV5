<?xml version="1.0" encoding="UTF-8"?>
<!--
  persistence-model — общий артефакт ФОРМ PERSISTENCE-СЛОЯ, общих у
  сервисов со своей базой (docs/architecture/services.md §«Общие артефакты
  монорепозитория»). Собирается в сервисы, сам не разворачивается.

  ЗАЧЕМ ОН ПОЯВИЛСЯ. Базовый тип полей аудита стоял ШЕСТЬЮ копиями — по
  одной у каждого владельца базы, — и пятая расходилась с шестой: у `auth`
  из шести колонок было объявлено четыре, при том что состав объявлен
  бинарным (docs/models/domain/other/Auditable.md §«Правило состава
  колонок»). Расхождение копий такого рода не наблюдаемо: каждая копия
  верна сама по себе.

  ПОЧЕМУ НЕ В domain-model. Тот артефакт тянут ВСЕ сервисы, включая тех, у
  кого базы нет вовсе (`bff`, `connector-okx`), и объявлен он чисто
  доменным. Положить сюда persistence сделало бы jakarta.persistence и
  spring-data обязательными для них (.claude/rules/codestyle.md §«Новый
  модуль монорепозитория»).

  РОДИТЕЛЬ — spring-boot-starter-parent, в отличие от domain-model.
  Причина та же, что у test-support: содержимое — формы поверх spring-data,
  и версия обязана совпадать с той, что каркас приносит потребителям. Своя
  закрепка разошлась бы с ними молча.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>persistence-model</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>persistence-model</name>
    <description>Общие формы persistence-слоя: базовый тип полей аудита</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
          spring-data-jpa, а не стартер: артефакт несёт ОТОБРАЖЕНИЕ, а не
          подключение. Стартер втянул бы Hibernate, пул соединений и
          автоконфигурацию — то есть решил бы за потребителя то, что тот
          решает сам (у владельцев нескольких баз отображение объявлено
          явно). Отсюда же приезжает jakarta.persistence-api и аннотации
          аудита spring-data-commons.
        -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>
        <!--
          jakarta.persistence-api объявлен ЯВНО: spring-data-jpa 4 его
          транзитивно не отдаёт, а формы отображения без него не
          компилируются. У потребителей он и так есть — приезжает с
          spring-boot-starter-data-jpa.
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Ломбок — процессор аннотаций, и путь к нему объявляется
              явно: родитель его версию управляет, но в processorPath не
              ставит. Без него аксессоры не порождаются МОЛЧА — класс
              без собственных читателей собирается, а потребитель падает.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
              Перепаковки нет: артефакт не приложение, а библиотека. Плагин
              Boot, унаследованный от родителя, обычную банку заменил бы
              исполняемой, и потребитель не увидел бы её классов.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
