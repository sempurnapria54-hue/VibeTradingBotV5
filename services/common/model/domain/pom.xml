<?xml version="1.0" encoding="UTF-8"?>
<!--
  domain-model — общий артефакт: доменные сущности, перечни и конверт
  события (docs/architecture/services.md §«Общие артефакты
  монорепозитория»). Собирается в сервисы, сам не разворачивается.

  ЗАВИСИМОСТЕЙ МИНИМУМ, И ЭТО НЕСУЩЕЕ СВОЙСТВО. Библиотеку тянут в себя
  ВСЕ сервисы; всякая зависимость здесь становится обязательной для
  каждого. Поэтому здесь нет ни веб-стека, ни персистентности, ни
  MapStruct: маппинг принадлежит границам сервиса, а не форме.

  Родителя нет намеренно (агрегирующий pom модули не наследуются, см.
  корневой pom.xml): наследование spring-boot-starter-parent втянуло бы
  в библиотеку управление версиями всего бут-стека.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>domain-model</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>domain-model</name>
    <description>Доменные сущности, перечни и конверт события</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.42</lombok.version>
        <commons-lang3.version>3.19.0</commons-lang3.version>
        <commons-collections4.version>4.5.0</commons-collections4.version>
        <jackson-annotations.version>2.20</jackson-annotations.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <!--
          Версии тестовой оснастки закреплены ЗДЕСЬ, потому что родителя у
          модуля нет (см. шапку). Взяты те, что закрепляет
          spring-boot-dependencies 4.0.0 — иначе дерево держало бы два
          мажора junit сразу: один у этого артефакта, другой у всех
          сервисов.
        -->
        <junit-jupiter.version>6.0.1</junit-jupiter.version>
        <assertj.version>3.27.6</assertj.version>
        <!--
          Версия surefire закреплена по той же причине, что и версия
          компилятора: родителя нет, и умолчание Maven принесло бы провайдер
          3.2.5, которого в локальном репозитории не существует, — офлайновый
          реактор упал бы на резолве, а не на тесте. 3.5.4 — та, что уже
          лежит рядом: её приносит spring-boot-starter-parent остальным
          модулям дерева.
        -->
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Commons Lang3 и Collections4 — не удобство, а требование
          конвенции: .claude/rules/codestyle.md §«Строгие правила»
          предписывает BooleanUtils/StringUtils/CollectionUtils вместо
          ручных проверок. Доменные предикаты написаны по этой конвенции,
          значит библиотека их и несёт.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
        </dependency>
        <!--
          Аннотации Jackson — ПО ПРЕДЪЯВЛЕННОЙ ПОТРЕБНОСТИ: форма
          определения стратегии пересекает сериализацию (тело команды
          приёма, снимок в событии активации), а её действие полиморфно —
          без дискриминатора вида объявления разбор падает у ЧИТАТЕЛЯ.
          Артефакт общий у Jackson 2 и Jackson 3: третий мажор оставил
          аннотации на групповом идентификаторе второго
          (.claude/rules/tech-radar.md, записи Jackson).
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson-annotations.version}</version>
        </dependency>

        <!--
          ТЕСТОВАЯ ОСНАСТКА — ОБЛАСТЬ TEST, И ОБЯЗАТЕЛЬНОЙ ДЛЯ СЕРВИСОВ ОНА
          НЕ СТАНОВИТСЯ. Оговорка шапки «всякая зависимость здесь становится
          обязательной для каждого» адресует то, что потребитель НАСЛЕДУЕТ;
          область test в Maven не транзитивна. Проверяется деревом
          зависимостей потребителя, а не чтением этого файла.

          ЗАЧЕМ ОНА ЗДЕСЬ. У артефакта появилось своё тестовое дерево: две
          пробы его форм стоя́ли в дереве `auth` — у первого потребителя, —
          и снимались бы вместе с чужим деревом
          (.claude/tests/cases/domain-model-predicates.md §«Существующий
          набор предмета»). Стартера Boot здесь нет намеренно: он потянул бы
          управление версиями всего бут-стека, против чего и заведена шапка;
          берутся ровно два артефакта, которые пробы и зовут.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                  Версия закреплена явно: родителя у модуля нет, и без
                  закрепления Maven предупреждает о нестабильности сборки,
                  а версия плагина зависела бы от версии самого Maven.
                -->
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
