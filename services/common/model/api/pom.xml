<?xml version="1.0" encoding="UTF-8"?>
<!--
  api-model — общий артефакт ФОРМ API-СЛОЯ, одинаковых у всех внешних
  поверхностей (docs/architecture/services.md §«Общие артефакты
  монорепозитория»). Собирается в сервисы, сам не разворачивается.

  ЗАЧЕМ ОН ПОЯВИЛСЯ. Единый error-DTO объявлен КОНТРАКТОМ внешней
  поверхности (docs/rules/error-handling-policy.md §«Внешняя поверхность»),
  а стоял восемью копиями — по одной у каждого сервиса. Клейм «единый»
  при восьми носителях держится памятью: копии уже разошлись описаниями
  полей, и следующей разойдётся форма.

  ПОЧЕМУ НЕ В domain-model. Тот артефакт объявлен чисто доменным, а здесь
  лежит слой api: аннотации Swagger обязательны у каждого поля
  (.claude/rules/codestyle.md §«Контроллеры / API»), и втягивать их в
  доменную библиотеку значило бы сделать их обязательными для всех.

  ЗАВИСИМОСТЬ НА АННОТАЦИИ SWAGGER — В ОБЛАСТИ provided, И ЭТО НЕСУЩЕЕ.
  Их рантайм-копию каждому потребителю приносит его собственный стартер
  springdoc, поэтому библиотека версию за сервисы не закрепляет: разъезд
  версии здесь стал бы разъездом у всех восьми сразу.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>api-model</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>api-model</name>
    <description>Общие формы api-слоя: единый error-DTO и базовый тип audit-полей ответа</description>

    <properties>
        <java.version>25</java.version>
        <swagger-annotations.version>2.2.38</swagger-annotations.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger-annotations.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Ломбок — процессор аннотаций, и путь к нему объявляется
              явно: родитель его версию управляет, но в processorPath не
              ставит. Без него аксессоры не порождаются МОЛЧА — класс
              без собственных читателей собирается, а потребитель падает.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
              Перепаковки нет: артефакт не приложение, а библиотека. Плагин
              Boot, унаследованный от родителя, обычную банку заменил бы
              исполняемой, и потребитель не увидел бы её классов.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
