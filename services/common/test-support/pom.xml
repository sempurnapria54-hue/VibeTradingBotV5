<?xml version="1.0" encoding="UTF-8"?>
<!--
  test-support — общий артефакт ФОРМЫ ПРОБ, а не продуктового кода
  (docs/architecture/services.md §«Общие артефакты монорепозитория»).
  Собирается в сервисы только на ТЕСТОВЫЙ путь: потребители объявляют его
  со scope test, и в поставляемый образ он не попадает ни у одного.

  ЗАЧЕМ ОН ПОЯВИЛСЯ ЗДЕСЬ И НЕ РАНЬШЕ. Условие названо было заранее и
  сработало: у пробы вместимости планировщика появился ТРЕТИЙ сервис-носитель
  (audit-statistics, bff, trading-core), и до третьего копия была дешевле
  общего носителя, а с третьим — дороже. Заводить модуль превентивно
  запрещал тот же довод в обратную сторону (.claude/rules/design-simplicity.md).

  РОДИТЕЛЬ — spring-boot-starter-parent, в отличие от domain-model. Причина
  обратная тамошней: содержимое этого артефакта — тестовая оснастка Boot, и
  версии junit, assertj и spring-boot-test обязаны совпадать с теми, что
  каркас приносит потребителям. Своя закрепка версий разошлась бы с ними
  молча.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>test-support</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>test-support</name>
    <description>Общие формы проб: вместимость планировщика, JSONB-навес</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!--
          Стартер тестов идёт БЕЗ scope test, и это не оплошность: сами
          формы проб лежат в src/main этого модуля — иначе потребитель не
          увидел бы их, а test-jar завёл бы второй артефакт там, где хватает
          одного. У потребителей зависимость объявлена со scope test, и
          дальше него стартер не уезжает.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <!--
          Автоконфигурация планировщика — предмет пробы доезда величины:
          проба обязана собирать планировщик ТЕМ ЖЕ автоконфигом, каким его
          собирает Boot у сервиса, иначе она мерила бы свою сборку.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!--
          Jackson 2 — под раннер исполнимых спецификаций
          (src/test/.../spec), который разбирает docs/spec/*.json, И под
          общую сборку проб JSONB-навеса (JsonbOverlayProbe). Причина
          предъявлена компилятором, а не взята впрок: без него не собрались
          бы ни раннер (ObjectMapper, JsonParser), ни сборка проб.

          SCOPE TEST СНЯТ ВТОРЫМ ПОТРЕБИТЕЛЕМ: пока Jackson был нужен только
          раннеру, тестовый scope держал его внутри модуля. Сборка проб живёт
          в src/main — иначе её не увидел бы наследник в дереве сервиса, —
          и с нею зависимость стала обязательной. Потребителям она уезжает
          тестовым scope самого артефакта, дальше него не идёт.

          ВЕРСИЯ НЕ ЗАКРЕПЛЕНА ЗДЕСЬ: её даёт BOM родителя. Раннер к выбору
          между Jackson 2 и 3 отношения не имеет — он читает корпусный JSON,
          а не провод (`.claude/rules/tech-radar.md`, строки Jackson).
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
          Общая доменная модель — формы, проходящие через конвертеры навеса
          трёх сервисов: контракты копий навеса объявляют их в сигнатурах
          портов. Причина предъявлена компилятором: без неё testCompile
          потребителя не собрал бы наследника контракта.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Общий артефакт периметра — формы, чьё ТОЖДЕСТВО у копий мерится
          одним ожиданием на две копии: класс недоступности соседа
          (PeerServiceUnavailableException) лежит здесь одним экземпляром, и
          контракт копий называет его в сигнатуре. Причина предъявлена
          компилятором: без него не собрался бы PeerCallContract.

          НОВОЙ ОБЯЗАННОСТИ ПОТРЕБИТЕЛЮ ЭТО НЕ ДОБАВЛЯЕТ: все шесть
          потребителей test-support объявляют platform сами, на compile
          (.claude/rules/codestyle.md §«Новый модуль монорепозитория»).
          Вместе с ним приезжают spring-web и spring-security-core, на
          которых стоя́т входы контрактов.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          oauth2-client — ОБЛАСТЬ optional, по тому же доводу, что и у
          platform: контракт провайдера служебного токена нужен двум
          деревьям из шести (trading-core, strategies), и оба объявляют
          starter-oauth2-client сами. Транзитивная зависимость сделала бы
          его обязательным для остальных четырёх.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Перепаковки нет: артефакт не приложение, а библиотека. Плагин
              Boot, унаследованный от родителя, обычную банку заменил бы
              исполняемой, и потребитель не увидел бы её классов.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
