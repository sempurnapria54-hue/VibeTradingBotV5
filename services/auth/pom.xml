<?xml version="1.0" encoding="UTF-8"?>
<!--
  auth — владелец «кто есть кто»: тенанты, членства с ролями, реестр
  биржевых счетов тенанта (ключи — в Vault, не здесь)
  (docs/architecture/services.md).

  Читается всеми, пишется одним: это и есть довод за отдельный процесс.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>auth</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>auth</name>
    <description>Тенанты, членства, реестр биржевых счетов</description>

    <properties>
        <java.version>25</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.0</springdoc.version>
        <!-- Release train под Spring Boot 4: 2025.1.x. -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <!--
          Стаб чужой HTTP-поверхности: здесь — точки провайдера
          идентичности (диспетчер OIDC и JWKS). Затенённый артефакт, а не
          обычный: его Jetty и Jackson не встречаются с Tomcat и Jackson
          контекста сервиса (.claude/decisions/test-contour-design-pass.md,
          решение 3). Версия своя — управления Boot у неё нет.
        -->
        <wiremock.version>3.13.1</wiremock.version>
        <!--
          Метка красных ожиданий, изъятая из умолчания прогона: дом довода —
          services/common/platform/pom.xml, свойство того же имени.
          Прогон помеченных:  mvn test -Dtest.excluded.groups=
        -->
        <test.excluded.groups>debt</test.excluded.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Формы доменных сущностей — из общего артефакта, не свои. -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Общий базовый тип audit-полей persistence-слоя: состав колонок
          бинарен, и единственный носитель его и держит.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>persistence-model</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
          Общие формы api-слоя: единый error-DTO — контракт внешней
          поверхности, и его клейм держится единственностью носителя.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>api-model</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
          Общие исполнители периметра: отсюда берётся резолвер актора
          записи. Берётся ИМЕНОВАННО — через @Import на классе приложения.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>platform</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          ПРОБА ЖИВОСТИ — ОБЪЯВЛЕННАЯ ПОВЕРХНОСТЬ, а не удобство: она
          единственная открытая точка контура доступа
          (docs/rules/api-access-policy.md), и на неё же смотрят пробы
          готовности и живости в манифесте развёртывания. Без стартера
          актуатора эндпойнта не существует вовсе: конфигурация
          management.endpoints.* и правило permitAll в SecurityConfig
          оставались объявлениями без предмета, а всякий запрос к
          /actuator/health отвечал 401. Обнаружено первым развёртыванием
          (локальный стенд): под не становился готовым никогда.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Ресурс-сервер, а не Basic: поверхность целевых сервисов ходит на
          bearer-токене провайдера идентичности, подпись проверяется
          локально по его ключам (docs/rules/api-access-policy.md
          §«Два контура доступа сосуществуют, пока жив донор»).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!--
          Бин ObjectMapper совместимостным автоконфигом Jackson 2: его берёт
          энфорсер отказа доступа общего артефакта (AccessDenialHandler), и
          отказ фильтр-цепочки отвечает тем же error-DTO, что прочие ошибки
          поверхности (docs/rules/error-handling-policy.md; записи Jackson —
          .claude/rules/tech-radar.md).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <!--
          СТАРТЕР, А НЕ flyway-core. Boot 4 разнёс автоконфиги по модулям:
          flyway-core на classpath даёт биндинг spring.flyway.* и сам
          Flyway, но автоконфиг, ЗАПУСКАЮЩИЙ миграции на старте, живёт в
          модуле spring-boot-flyway и сам не подтягивается. С одним
          flyway-core миграции молча не применяются, и сервис падает уже на
          валидации схемы. Обнаружено первым развёртыванием (локальный
          стенд); донор ту же ловушку прошёл раньше и записал её у себя.
          flyway-database-postgresql стартер не тянет — держим явно.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          Хранилище секретов: ключи биржевых счетов. Config-import сюда не
          заводится намеренно — ключи не свойства процесса, а операнд
          вызова, и читаются VaultTemplate по адресу счёта
          (docs/architecture/tenant-and-exchange.md §Ключи).
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-vault-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          СУБСТРАТ ЧЁРНОГО ЯЩИКА (уровень 1 шага 12 фазы 2). База и
          хранилище секретов приезжают контейнерами прогона, а не берутся
          из docker-compose машины: прогон, зависящий от состояния машины,
          мерит машину (.claude/decisions/test-contour-design-pass.md,
          решения 2 и 5). Версию держит Boot — testcontainers-bom его
          управления; своя разошлась бы с каркасом.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Хранилище секретов: `auth` — единственное место платформы, где
          ключи счёта ПИШУТСЯ, и запись есть его собственный выход
          (решение 5).
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-vault</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Метка красных ожиданий вне умолчания прогона — довод у свойства. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
            <!--
              Исполняемый артефакт сервиса. Без repackage сборка даёт
              обычный jar без зависимостей и без манифеста запуска — то
              есть образ сервиса собрать не из чего. Обнаружено первым
              развёртыванием (локальный стенд): донор плагин несёт, а
              сервисы, заведённые шагами 4-6, его не унаследовали —
              родитель объявляет только УПРАВЛЕНИЕ версией плагина, а не
              его подключение.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
