<?xml version="1.0" encoding="UTF-8"?>
<!--
  trading-core — торговое ядро (docs/architecture/services.md): сделки и
  транши, машины состояний, командная механика, риск-гейт, холды,
  аномалии, наблюдение фактов исполнения опросом, outbox.

  СВОЯ БАЗА ЕСТЬ И ОНА ЦЕНТРАЛЬНАЯ: ядро — единственный писатель сделок,
  строк исполнения, движений средств и зеркала заявок
  (docs/architecture/data-ownership.md §Раскладка). Отсюда JPA, Flyway и
  драйвер Postgres.

  КЛЮЧЕЙ БИРЖЕВОГО СЧЁТА НЕ ЧИТАЕТ: команды площадке идут через
  коннектор, а ключи резолвит он (docs/architecture/contracts.md
  §«Синхронные вызовы»). Vault здесь не нужен ни в каком виде.

  К СОСЕДЯМ ХОДИТ ПОД СЕРВИСНОЙ ИДЕНТИЧНОСТЬЮ КЛАСТЕРА: к коннектору за
  командами и фактами, к `auth` за реестром счетов, к `market-data` за
  фичами и каталогом. Отсюда oauth2-client рядом с resource-server —
  первый добывает токен исходящему вызову, второй проверяет входящий.

  БРОКЕР В ЗАВИСИМОСТЯХ ЕСТЬ, А АВТОКОНФИГУРАЦИИ ЕГО НЕТ: Boot 4 разнёс
  автоконфигурацию по модулям `spring-boot-<технология>`, и `spring-kafka`
  сам по себе ни фабрик, ни обработки @KafkaListener не поднимает. Клиент
  поэтому объявлен явно (CoreKafkaConfig) — той же формой, какой ось
  закрыли два durable-потребителя. Прежняя редакция этого комментария
  говорила «брокера в зависимостях пока нет»; она описывала дерево до
  прихода реле.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>trading-core</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>trading-core</name>
    <description>Торговое ядро: сделки, исполнение, риск, холды</description>

    <properties>
        <java.version>25</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.0</springdoc.version>
        <!--
          Метка красных ожиданий, изъятая из умолчания прогона: дом довода —
          services/common/platform/pom.xml, свойство того же имени.
          Прогон помеченных:  mvn test -Dtest.excluded.groups=
        -->
        <test.excluded.groups>debt</test.excluded.groups>
        <wiremock.version>3.13.1</wiremock.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Общий базовый тип audit-полей persistence-слоя: состав колонок
          бинарен, и единственный носитель его и держит.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>persistence-model</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
          Общие формы api-слоя: единый error-DTO — контракт внешней
          поверхности, и его клейм держится единственностью носителя.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>api-model</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
          Общие исполнители периметра: охрана джобы, резолвер актора,
          точки входа отказа доступа, исходящая сервисная идентичность.
          Берётся ИМЕНОВАННО — через @Import на классе приложения.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>platform</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
          Формы сообщений внутренней шины — общий артефакт `common/model/message`:
          конверт события
          и содержимое его классов (docs/architecture/services.md §«Общие
          артефакты монорепозитория»). Слой сообщения отделён от домена и
          от интеграции с внешним (.claude/rules/codestyle.md §«Слой
          сообщения: внутренняя шина»).
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>message-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Движок стратегий: интерпретатор условий и расчётный слой —
          общий артефакт, а не копия в ядре (docs/architecture/services.md
          §«Общие артефакты монорепозитория»).
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>strategy-engine</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          ПРОБА ЖИВОСТИ — ОБЪЯВЛЕННАЯ ПОВЕРХНОСТЬ, а не удобство: она
          единственная открытая точка контура доступа
          (docs/rules/api-access-policy.md), и на неё же смотрят пробы
          готовности и живости в манифесте развёртывания.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          RestClient.Builder переехал в отдельный модуль в Boot 4:
          starter-web несёт серверную часть, клиентский автоконфиг — здесь.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          СТАРТЕР, А НЕ flyway-core: автоконфиг, ЗАПУСКАЮЩИЙ миграции на
          старте, живёт в модуле spring-boot-flyway и сам не
          подтягивается. С одним flyway-core миграции молча не
          применяются, и сервис падает уже на валидации схемы.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.5.0</version>
        </dependency>
        <!--
          Jackson 2 — интерим на время миграции кодовой базы
          (.claude/rules/tech-radar.md, строка Jackson 2): JSONB-навес
          условий, целей и ошибок сериализуется им.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <!--
          Kafka — публикация накопленного в outbox
          (docs/components/OutboxRelayJob.md). Введена по предъявленной
          потребности: реле публикует в тему производителя, и без клиента
          брокера компонент не собирается.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    
        <!--
          Общая форма пробы вместимости планировщика: у сервиса есть
          ИЗМЕРИТЕЛЬ среди джоб, и вывод размера пула обязан иметь охрану
          (.claude/rules/codestyle.md §Джобы). Scope test — дальше тестового
          пути артефакт не уезжает.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          СУБСТРАТ ЧЁРНОГО ЯЩИКА (уровень 1 шага 12 фазы 2). База приезжает
          контейнером прогона, а не берётся из docker-compose машины: прогон,
          зависящий от состояния машины, мерит машину
          (.claude/decisions/test-contour-design-pass.md, решения 1-3).
          Образ базы — ТОТ ЖЕ, что в deploy/base, и совпадение тега сверяет
          проба: две записи одного тега разошлись бы молча.

          БРОКЕР НУЖЕН ОБЕИМИ СТОРОНАМИ: ядро и публикует через outbox, и
          потребляет тему определений (.claude/tests/cases/trading-core.md
          §«Чем достаются выходы»). Тропа к нему объявлена этим же заходом —
          автоконфигурации Kafka в дереве нет, и клиент объявлен явно
          (CoreKafkaConfig).

          ХРАНИЛИЩА СЕКРЕТОВ ЗДЕСЬ НЕТ: ключей биржевого счёта у ядра нет ни
          в каком виде — оно адресует счёт идентичностью, а ключи держит
          коннектор (docs/architecture/services/trading-core.md §«Чего не
          делает намеренно»).
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Стаб чужой HTTP-поверхности — один механизм на три вида: коннектор,
          соседи по ярусу и точки провайдера идентичности. Затенённый
          артефакт: его Jetty и Jackson не встречаются с Tomcat и Jackson
          контекста сервиса.
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Исполняемый артефакт сервиса: без repackage образ собрать не из чего. -->
            <!-- Метка красных ожиданий вне умолчания прогона — довод у свойства. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
