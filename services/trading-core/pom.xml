<?xml version="1.0" encoding="UTF-8"?>
<!--
  trading-core — торговое ядро (docs/architecture/services.md): сделки и
  транши, машины состояний, командная механика, риск-гейт, холды,
  аномалии, наблюдение фактов исполнения опросом, outbox.

  СВОЯ БАЗА ЕСТЬ И ОНА ЦЕНТРАЛЬНАЯ: ядро — единственный писатель сделок,
  строк исполнения, движений средств и зеркала заявок
  (docs/architecture/data-ownership.md §Раскладка). Отсюда JPA, Flyway и
  драйвер Postgres.

  КЛЮЧЕЙ БИРЖЕВОГО СЧЁТА НЕ ЧИТАЕТ: команды площадке идут через
  коннектор, а ключи резолвит он (docs/architecture/contracts.md
  §«Синхронные вызовы»). Vault здесь не нужен ни в каком виде.

  К СОСЕДЯМ ХОДИТ ПОД СЕРВИСНОЙ ИДЕНТИЧНОСТЬЮ КЛАСТЕРА: к коннектору за
  командами и фактами, к `auth` за реестром счетов, к `market-data` за
  фичами и каталогом. Отсюда oauth2-client рядом с resource-server —
  первый добывает токен исходящему вызову, второй проверяет входящий.

  БРОКЕРА В ЗАВИСИМОСТЯХ ПОКА НЕТ: строку outbox пишет код решения, а
  публикует реле — оно приезжает своим компонентом захода, и зависимость
  вводится вместе с ним, а не превентивно (.claude/rules/codestyle.md
  §«Новый модуль монорепозитория»).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>trading-core</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>trading-core</name>
    <description>Торговое ядро: сделки, исполнение, риск, холды</description>

    <properties>
        <java.version>25</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.0</springdoc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Движок стратегий: интерпретатор условий и расчётный слой —
          общий артефакт, а не копия в ядре (docs/architecture/services.md
          §«Общие артефакты монорепозитория»).
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>strategy-engine</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          ПРОБА ЖИВОСТИ — ОБЪЯВЛЕННАЯ ПОВЕРХНОСТЬ, а не удобство: она
          единственная открытая точка контура доступа
          (docs/rules/api-access-policy.md), и на неё же смотрят пробы
          готовности и живости в манифесте развёртывания.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          RestClient.Builder переехал в отдельный модуль в Boot 4:
          starter-web несёт серверную часть, клиентский автоконфиг — здесь.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          СТАРТЕР, А НЕ flyway-core: автоконфиг, ЗАПУСКАЮЩИЙ миграции на
          старте, живёт в модуле spring-boot-flyway и сам не
          подтягивается. С одним flyway-core миграции молча не
          применяются, и сервис падает уже на валидации схемы.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.5.0</version>
        </dependency>
        <!--
          Jackson 2 — интерим на время миграции кодовой базы
          (.claude/rules/tech-radar.md, строка Jackson 2): JSONB-навес
          условий, целей и ошибок сериализуется им.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Исполняемый артефакт сервиса: без repackage образ собрать не из чего. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
