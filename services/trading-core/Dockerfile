# Образ сервиса trading-core.
#
# Артефакт СОБИРАЕТСЯ РЕАКТОРОМ, а не внутри образа: сборка в контейнере
# заново тянула бы зависимости, которые уже лежат в локальном репозитории,
# и делала бы образ зависимым от сети. Поэтому контекст сборки — каталог
# сервиса с готовым target/*.jar, а команда сборки — в доме команд стенда
# (.claude/skills/local-stand.md).
FROM eclipse-temurin:25-jre

# Непривилегированный пользователь: числовой uid работает без записи в
# /etc/passwd и не требует правки базового образа.
USER 10001:10001

WORKDIR /app
COPY target/trading-core-0.0.1-SNAPSHOT.jar /app/app.jar

# Порт поверхности сервиса; ингресс и сетевые политики адресуют его.
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
