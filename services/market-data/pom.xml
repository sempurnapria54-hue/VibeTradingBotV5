<?xml version="1.0" encoding="UTF-8"?>
<!--
  market-data — сбор рыночных данных и производных от них
  (docs/architecture/services.md): свечи по требованию потребителя,
  невосполнимые срезы по всему листингу, индикаторы, структура и фаза
  рынка, история для бэктеста.

  СВОЯ БАЗА ЕСТЬ, и это не симметрия с остальными сервисами: он
  единственный писатель рядов рыночных данных
  (docs/architecture/data-ownership.md §«Временные ряды»). Отсюда JPA,
  Flyway и драйвер Postgres в зависимостях; ряды лежат гипертаблицами
  TimescaleDB того же кластера.

  КЛЮЧЕЙ БИРЖЕВЫХ СЧЕТОВ НЕ ЧИТАЕТ: все его чтения площадки публичные
  (docs/architecture/contracts.md §«Синхронные вызовы»), поэтому Vault
  здесь нет ни в каком виде — ни config-import, ни VaultTemplate.

  К КОННЕКТОРУ ХОДИТ ПОД СЕРВИСНОЙ ИДЕНТИЧНОСТЬЮ КЛАСТЕРА
  (contracts.md §«Контекст тенанта в вызове»): межсервисный вызов без
  пользователя. Отсюда oauth2-client рядом с resource-server — первый
  добывает токен исходящему вызову, второй проверяет входящий.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>market-data</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>market-data</name>
    <description>Сбор рыночных данных и производных от них</description>

    <properties>
        <java.version>25</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.0</springdoc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Интерпретатор условий: фаза рынка резолвится по авторским клаузам
          потребителя (docs/components/MarketPhaseResolver.md). Грамматику
          держит общий артефакт — своей копии сервис не заводит.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>strategy-engine</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          RestClient.Builder переехал в отдельный модуль в Boot 4:
          starter-web несёт серверную часть, клиентский автоконфиг — здесь.
          Клиент нужен для чтений у коннектора.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.5.0</version>
        </dependency>
        <!--
          Jackson 2 — интерим на время миграции кодовой базы
          (.claude/rules/tech-radar.md, строка Jackson 2): JSONB-навес
          правил инструмента и уровни срезов сериализуются им.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
