<?xml version="1.0" encoding="UTF-8"?>
<!--
  connector-okx — граница с площадкой OKX: маппинг запросов и ответов,
  подпись, лимиты, наблюдение фактов исполнения
  (docs/architecture/services.md; входной контракт —
  docs/components/IntegrationService.md §«Входной контракт»).

  СВОЕЙ БАЗЫ НЕТ, и это не упущение: гарантию полноты фактов держит
  наблюдение ядром, а не хранилище коннектора — биржа источник истины,
  подтверждение приёма истиной не является
  (docs/rules/ack-not-runtime-truth.md). Отсюда ни JPA, ни Flyway, ни
  outbox в зависимостях.

  Ключи счетов коннектор ЧИТАЕТ из Vault по идентификатору счёта из
  запроса (docs/architecture/tenant-and-exchange.md §Ключи); права писать
  их у него нет.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>connector-okx</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>connector-okx</name>
    <description>Граница с площадкой OKX</description>

    <properties>
        <java.version>25</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.0</springdoc.version>
        <!-- Release train под Spring Boot 4: 2025.1.x. -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <!--
          Стаб чужой HTTP-поверхности: здесь — САМА ПЛОЩАДКА OKX, точки
          провайдера идентичности и поверхности соседей по ярусу. Затенённый
          артефакт, а не обычный: его Jetty и Jackson не встречаются с Tomcat и
          Jackson контекста сервиса (.claude/decisions/test-contour-design-pass.md,
          решение 3). Версия своя — управления Boot у неё нет.
        -->
        <wiremock.version>3.13.1</wiremock.version>
        <!--
          Метка красных ожиданий, изъятая из умолчания прогона: дом довода —
          services/common/platform/pom.xml, свойство того же имени.
          Прогон помеченных:  mvn test -Dtest.excluded.groups=
        -->
        <test.excluded.groups>debt</test.excluded.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>domain-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Общие формы api-слоя: единый error-DTO — контракт внешней
          поверхности, и его клейм держится единственностью носителя.
        -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>api-model</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          ПРОБА ЖИВОСТИ — ОБЪЯВЛЕННАЯ ПОВЕРХНОСТЬ, а не удобство: она
          единственная открытая точка контура доступа
          (docs/rules/api-access-policy.md), и на неё же смотрят пробы
          готовности и живости в манифесте развёртывания. Без стартера
          актуатора эндпойнта не существует вовсе: конфигурация
          management.endpoints.* и правило permitAll в SecurityConfig
          оставались объявлениями без предмета, а всякий запрос к
          /actuator/health отвечал 401. Обнаружено первым развёртыванием
          (локальный стенд): под не становился готовым никогда.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          RestClient.Builder переехал в отдельный модуль в Boot 4:
          starter-web несёт серверную часть, клиентский автоконфиг — здесь.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.5.0</version>
        </dependency>
        <!--
          Jackson 2 — интерим на время миграции кодовой базы: DTO
          источника аннотированы им (.claude/rules/tech-radar.md,
          строка Jackson 2).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          Хранилище секретов: ключи биржевых счетов. Config-import сюда не
          заводится намеренно — ключи не свойства процесса, а операнд
          вызова, и читаются VaultTemplate по адресу счёта
          (docs/architecture/tenant-and-exchange.md §Ключи).
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-vault-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          СУБСТРАТ ЧЁРНОГО ЯЩИКА (уровень 1 шага 12 фазы 2). Контейнера базы
          здесь НЕТ, и это не пропуск: своей базы у коннектора нет по
          построению, и клетка B10.1 как раз на том и стои́т, что прогон её не
          поднимает. Хранилище секретов приезжает контейнером прогона, а не
          берётся из docker-compose машины: прогон, зависящий от состояния
          машины, мерит машину (.claude/decisions/test-contour-design-pass.md,
          решения 2 и 5). Версию держит Boot — testcontainers-bom его
          управления; своя разошлась бы с каркасом.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-vault</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Метка красных ожиданий вне умолчания прогона — довод у свойства. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
            <!--
              Исполняемый артефакт сервиса. Без repackage сборка даёт
              обычный jar без зависимостей и без манифеста запуска — то
              есть образ сервиса собрать не из чего. Обнаружено первым
              развёртыванием (локальный стенд): донор плагин несёт, а
              сервисы, заведённые шагами 4-6, его не унаследовали —
              родитель объявляет только УПРАВЛЕНИЕ версией плагина, а не
              его подключение.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
