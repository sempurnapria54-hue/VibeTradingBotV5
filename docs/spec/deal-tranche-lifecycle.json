    },
    {
      "case": "переоткрытие запрещено объявлением: то же ребро не применяется",
      "state": {
        "from": "MANAGING",
        "to": "ENTRY_SUBMITTED",
        "reopenAllowed": false,
        "orders": [
          {
            "type": "ENTRY_ATTACHED_STOP_LOSS",
            "status": "COMPLETED",
            "accumulatedFillSize": 5
          },
          {
            "type": "ENTRY_ATTACHED_STOP_LOSS",
            "status": "ACTIVE",
