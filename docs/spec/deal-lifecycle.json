{
  "subject": "deal-lifecycle",
  "question": "Какие переходы статуса сделки допустимы",
  "home": "docs/lifecycles/Deal.md",
  "includes": ["protection-coverage"],

  "operands": {
    "from": "текущий статус сделки",
    "to": "предполагаемый статус",
    "tranches[].status": "статус транша; резолв переходов — docs/spec/deal-tranche-lifecycle.json",
    "tranches[].orders[]": "заявки транша — операнд его живого риска",
    "position.live": "живой эпизод существует",
    "resultProfit": "число результата сделки; пусто — неисчислимо",
    "resultProfitCurrency": "валюта результата; пусто — не резолвилась",
    "hadEntry": "по сделке были операции на бирже"
  },

  "values": [
    {
      "name": "isTerminal",
      "expr": "in(status, 'CLOSED', 'EMERGENCY_CLOSED')"
    },
    {
      "name": "isActive",
      "note": "Ошибочное состояние активно: сделка держит слот инструмента, пока не дойдёт до терминала.",
      "expr": "in(status, 'ACTIVE', 'EXIT_PENDING', 'ERROR')"
    },
    {
      "name": "edgeDeclared",
      "note": "Объявленное ребро статусной машины агрегата. Статусов входа у него нет: они принадлежат траншу.",
      "expr": "(from == 'ACTIVE' && in(to, 'EXIT_PENDING', 'CLOSED', 'ERROR')) || (from == 'EXIT_PENDING' && in(to, 'CLOSED', 'ERROR')) || (from == 'ERROR' && to == 'EMERGENCY_CLOSED')"
    },
    {
      "name": "allTranchesTerminal",
      "op": "all",
      "over": "tranches",
      "of": "status == 'CLOSED'"
    },
    {
      "name": "riskProvenAbsent",
      "note": "Живой риск снят и это подтверждено фактами: эпизода нет, ни один транш риска не несёт.",
      "expr": "!position.live && !dealRiskBearing"
    },
    {
      "name": "cleanTerminalContract",
      "note": "Штатный терминал: число обязательно всегда; валюта — кроме троп закрытия без входа, где она пишется, только если резолвится.",
      "expr": "notNull(resultProfit) && (notNull(resultProfitCurrency) || !hadEntry)"
    },
    {
      "name": "emergencyTerminalContract",
      "note": "Аварийный терминал: число best-effort по доступности. Пусто допустимо и означает «неисчислимо», ноль — нет. Терминальность траншей на этой тропе не гейт: строка транша стала бы второй точкой отказа аварийного контура.",
      "expr": "true"
    },
    {
      "name": "transitionAllowed",
      "note": "Переход разрешён: ребро объявлено и выполнен контракт целевого статуса. Штатный терминал дополнительно требует терминальности всех траншей.",
      "expr": "edgeDeclared && (to != 'CLOSED' || (allTranchesTerminal && riskProvenAbsent && cleanTerminalContract)) && (to != 'EMERGENCY_CLOSED' || riskProvenAbsent)"
    }
  ],

  "examples": [
    {
      "case": "сделка уходит в координированный выход из сопровождения",
      "state": {
        "from": "ACTIVE", "to": "EXIT_PENDING", "position": { "live": true },
        "tranches": [ { "status": "MANAGING", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 3 } ], "protections": [] } ],
        "resultProfit": null, "resultProfitCurrency": null, "hadEntry": true
      },
      "expect": { "edgeDeclared": true, "transitionAllowed": true }
    },
    {
      "case": "статусов входа у агрегата нет: ребра в подтверждённый вход не существует",
      "state": {
        "from": "ACTIVE", "to": "ENTRY_FINALIZED", "position": { "live": true },
        "tranches": [ { "status": "ENTRY_SUBMITTED", "orders": [], "protections": [] } ],
        "resultProfit": null, "resultProfitCurrency": null, "hadEntry": true
      },
      "expect": { "edgeDeclared": false, "transitionAllowed": false }
    },
    {
      "case": "из ошибочного состояния в штатный терминал ребра нет",
      "state": {
        "from": "ERROR", "to": "CLOSED", "position": { "live": false },
        "tranches": [ { "status": "CLOSED", "orders": [], "protections": [] } ],
        "resultProfit": 12.5, "resultProfitCurrency": "USDT", "hadEntry": true
      },
      "expect": { "edgeDeclared": false, "transitionAllowed": false }
    },
    {
      "case": "штатный терминал при живом транше не применяется",
      "state": {
        "from": "EXIT_PENDING", "to": "CLOSED", "position": { "live": true },
        "tranches": [
          { "status": "CLOSED", "orders": [], "protections": [] },
          { "status": "EXIT_PENDING", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 3 } ], "protections": [] }
        ],
        "resultProfit": 12.5, "resultProfitCurrency": "USDT", "hadEntry": true
      },
      "expect": { "allTranchesTerminal": false, "dealRiskBearing": true, "riskProvenAbsent": false, "transitionAllowed": false }
    },
    {
      "case": "штатный терминал применяется, когда все транши закрыты и живого риска нет",
      "state": {
        "from": "EXIT_PENDING", "to": "CLOSED", "position": { "live": false },
        "tranches": [
          { "status": "CLOSED", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 3 }, { "type": "REDUCE_ONLY", "status": "COMPLETED", "accumulatedFillSize": 3 } ], "protections": [] },
          { "status": "CLOSED", "orders": [], "protections": [] }
        ],
        "resultProfit": 12.5, "resultProfitCurrency": "USDT", "hadEntry": true
      },
      "expect": { "allTranchesTerminal": true, "riskProvenAbsent": true, "transitionAllowed": true }
    },
    {
      "case": "штатный терминал без числа не применяется",
      "state": {
        "from": "EXIT_PENDING", "to": "CLOSED", "position": { "live": false },
        "tranches": [ { "status": "CLOSED", "orders": [], "protections": [] } ],
        "resultProfit": null, "resultProfitCurrency": "USDT", "hadEntry": true
      },
      "expect": { "cleanTerminalContract": false, "transitionAllowed": false }
    },
    {
      "case": "закрытие без входа: валюта не резолвилась, число есть — терминал применяется",
      "state": {
        "from": "ACTIVE", "to": "CLOSED", "position": { "live": false },
        "tranches": [ { "status": "CLOSED", "orders": [], "protections": [] } ],
        "resultProfit": 0, "resultProfitCurrency": null, "hadEntry": false
      },
      "expect": { "cleanTerminalContract": true, "transitionAllowed": true }
    },
    {
      "case": "состоявшаяся сделка без валюты результата штатный терминал не проходит",
      "state": {
        "from": "EXIT_PENDING", "to": "CLOSED", "position": { "live": false },
        "tranches": [ { "status": "CLOSED", "orders": [], "protections": [] } ],
        "resultProfit": 12.5, "resultProfitCurrency": null, "hadEntry": true
      },
      "expect": { "cleanTerminalContract": false, "transitionAllowed": false }
    },
    {
      "case": "аварийный терминал допускает пустое число и незакрытую строку транша, но не живой риск",
      "state": {
        "from": "ERROR", "to": "EMERGENCY_CLOSED", "position": { "live": false },
        "tranches": [ { "status": "MANAGING", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 3 }, { "type": "REDUCE_ONLY", "status": "COMPLETED", "accumulatedFillSize": 3 } ], "protections": [] } ],
        "resultProfit": null, "resultProfitCurrency": null, "hadEntry": true
      },
      "expect": { "allTranchesTerminal": false, "riskProvenAbsent": true, "transitionAllowed": true }
    },
    {
      "case": "аварийный терминал при живой входной заявке транша не применяется",
      "state": {
        "from": "ERROR", "to": "EMERGENCY_CLOSED", "position": { "live": false },
        "tranches": [ { "status": "MANAGING", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "ACTIVE", "accumulatedFillSize": 0 } ], "protections": [] } ],
        "resultProfit": null, "resultProfitCurrency": null, "hadEntry": true
      },
      "expect": { "dealRiskBearing": true, "riskProvenAbsent": false, "transitionAllowed": false }
    },
    {
      "case": "ошибочное состояние активно и держит слот инструмента",
      "state": { "status": "ERROR" },
      "expect": { "isActive": true, "isTerminal": false }
    },
    {
      "case": "терминальные статусы обработчиков не имеют",
      "state": { "status": "CLOSED" },
      "expect": { "isTerminal": true, "isActive": false }
    }
  ]
}
