{
  "subject": "algo-order-lifecycle",
  "question": "Какие переходы состояний допустимы у отдельной условной заявки",
  "home": "docs/lifecycles/AlgoOrder.md",

  "operands": {
    "from": "текущий статус",
    "to": "предполагаемый статус",
    "status": "статус для проверки свойств",
    "closeReason": "причина закрытия, требуемая переходом"
  },

  "values": [
    {
      "name": "algoIsLive",
      "expr": "in(status, 'CREATED', 'PENDING', 'ACTIVE', 'PARTIALLY_COMPLETED')"
    },
    {
      "name": "algoIsFinal",
      "expr": "in(status, 'COMPLETED', 'CANCELED', 'ERROR')"
    },
    {
      "name": "algoIsActiveLike",
      "note": "Заявка стоит на бирже. Созданная исключена — подтверждения нет; частично сработавшая включена — она жива и покрывает остаток.",
      "expr": "in(status, 'PENDING', 'ACTIVE', 'PARTIALLY_COMPLETED')"
    },
    {
      "name": "algoTransitionAllowed",
      "expr": "(isNull(from) && to == 'CREATED') || (from == 'CREATED' && in(to, 'PENDING', 'ERROR')) || (from == 'PENDING' && in(to, 'ACTIVE', 'COMPLETED', 'CANCELED', 'ERROR')) || (from == 'ACTIVE' && in(to, 'PARTIALLY_COMPLETED', 'COMPLETED', 'CANCELED', 'ERROR')) || (from == 'PARTIALLY_COMPLETED' && in(to, 'COMPLETED', 'CANCELED', 'ERROR'))"
    },
    {
      "name": "reasonRequired",
      "note": "Отмена и ошибка требуют непустой причины; срабатывание ставит свою.",
      "expr": "in(to, 'CANCELED', 'ERROR')"
    },
    {
      "name": "transitionAccepted",
      "expr": "algoTransitionAllowed && (!reasonRequired || notNull(closeReason))"
    }
  ],

  "examples": [
    {
      "case": "созданная условная заявка живой на бирже не считается",
      "state": { "status": "CREATED" },
      "expect": { "algoIsLive": true, "algoIsActiveLike": false }
    },
    {
      "case": "частично сработавшая жива и покрывает остаток",
      "state": { "status": "PARTIALLY_COMPLETED" },
      "expect": { "algoIsLive": true, "algoIsActiveLike": true, "algoIsFinal": false }
    },
    {
      "case": "из созданной сразу в активную нельзя — сперва отправка",
      "state": { "from": "CREATED", "to": "ACTIVE", "closeReason": null },
      "expect": { "algoTransitionAllowed": false }
    },
    {
      "case": "частичное срабатывание достижимо только из активной",
      "state": { "from": "PENDING", "to": "PARTIALLY_COMPLETED", "closeReason": null },
      "expect": { "algoTransitionAllowed": false }
    },
    {
      "case": "из активной в частично сработавшую — штатное восстановление по фактам",
      "state": { "from": "ACTIVE", "to": "PARTIALLY_COMPLETED", "closeReason": null },
      "expect": { "algoTransitionAllowed": true, "transitionAccepted": true }
    },
    {
      "case": "отмена без причины не принимается",
      "state": { "from": "ACTIVE", "to": "CANCELED", "closeReason": null },
      "expect": { "algoTransitionAllowed": true, "transitionAccepted": false }
    },
    {
      "case": "отмена с причиной замещения принимается",
      "state": { "from": "ACTIVE", "to": "CANCELED", "closeReason": "REPLACED_BY_STRATEGY" },
      "expect": { "transitionAccepted": true }
    },
    {
      "case": "терминальная заявка переходов не имеет",
      "state": { "from": "CANCELED", "to": "ACTIVE", "closeReason": null },
      "expect": { "algoTransitionAllowed": false }
    },
    {
      "case": "частично сработавшая доходит до полного срабатывания",
      "state": { "from": "PARTIALLY_COMPLETED", "to": "COMPLETED", "closeReason": null },
      "expect": { "transitionAccepted": true }
    }
  ]
}
