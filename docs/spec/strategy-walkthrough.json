{
  "subject": "strategy-walkthrough",
  "question": "Держится ли инвариант покрытия на каждом шаге прохода эталонного транша",
  "home": "docs/rules/live-risk-protection.md",
  "includes": ["protection-coverage"],

  "note": "Проход одного транша по эталонной стратегии trend-following-ema: вход со встроенным стопом → основная защита → безубыток → трейлинг → выход. Эталон объявляет один транш на торгуемую деталь, поэтому проход сделки и проход транша здесь совпадают. Каждый пример — состояние графа транша на одном шаге; операнды траншевые, соседних траншей в них нет по построению. На всех шагах утверждается отсутствие биржевой реакции ступени 2.",

  "operands": {
    "step": "шаг прохода — для читаемости отчёта",
    "protections[].chainRoot": "корень цепочки замещений: чем заявка была объявлена изначально",
    "declaredCancelTarget": "цель снятия, объявленная стратегией; может быть уже замещена",
    "остальные операнды": "как в protection-coverage, в траншевой области"
  },

  "values": [
    {
      "name": "noStageTwoReaction",
      "note": "Штатный проход не даёт биржевой ступени 2 ни на одном шаге.",
      "expr": "!trancheViolated"
    },
    {
      "name": "cancelTargetCandidates",
      "note": "Резолв объявленной цели снятия по цепочке замещений: живой потомок объявленной цели ровно один. Ноль означает, что снимать нечего; больше одного — цепочка разошлась.",
      "op": "count",
      "over": "protections",
      "where": "isLive && chainRoot == declaredCancelTarget",
      "of": "isLive"
    },
    {
      "name": "removalDeferred",
      "note": "Снятие отложено, а не отказано: покрытие снимаемой защиты пока не несёт никто другой.",
      "expr": "notNull(cancelTargetId) && !removalAllowed"
    }
  ],

  "examples": [
    {
      "case": "1. вход создан, отправки ещё не было — риска на бирже нет",
      "state": {
        "step": "PRECHECK / bull_entry CREATE",
        "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "CREATED", "accumulatedFillSize": 0 } ],
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "CREATED", "kind": "STOP", "size": 3, "parentFillSize": 0 }
        ],
        "commitments": [],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "trancheExposure": 0, "trancheCoverage": 0, "trancheViolated": false, "noStageTwoReaction": true }
    },
    {
      "case": "2. вход отправлен, факт не наблюдён — экспозиции ещё нет",
      "state": {
        "step": "SUBMIT bull_entry",
        "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "PENDING", "accumulatedFillSize": 0 } ],
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "PENDING", "kind": "STOP", "size": 3, "parentFillSize": 0 }
        ],
        "commitments": [ { "terminal": false, "budgetExhausted": false } ],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "trancheExposure": 0, "trancheHasLiveEntryOrder": true, "trancheViolated": false, "noStageTwoReaction": true }
    },
    {
      "case": "3. вход исполнен — экспозиция транша покрыта его встроенным стопом с первого момента",
      "state": {
        "step": "ENTRY_FINALIZED",
        "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 3 } ],
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "ACTIVE", "kind": "STOP", "size": 3, "parentFillSize": 3 }
        ],
        "commitments": [],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "trancheExposure": 3, "trancheCoverage": 3, "trancheCovered": true, "trancheViolated": false, "noStageTwoReaction": true }
    },
    {
      "case": "4. основная защита подтверждена — встроенную можно снимать",
      "state": {
        "step": "MAIN_PROTECTION bull_protection_oco подтверждён",
