{
  "subject": "strategy-walkthrough",
  "question": "Держится ли инвариант покрытия на каждом шаге прохода эталонной сделки",
  "home": "docs/rules/live-risk-protection.md",
  "includes": ["protection-coverage"],

  "note": "Проход одной длинной сделки по эталонной стратегии trend-following-ema: вход со встроенным стопом → основная защита → безубыток → трейлинг → выход. Каждый пример — состояние графа сделки на одном шаге. На всех шагах утверждается отсутствие биржевой реакции ступени 2: штатный проход её не даёт ни разу.",

  "operands": {
    "step": "шаг прохода — для читаемости отчёта",
    "protections[].id": "идентификатор заявки",
    "protections[].chainRoot": "корень цепочки замещений: чем заявка была объявлена изначально",
    "declaredCancelTarget": "цель снятия, объявленная стратегией; может быть уже замещена",
    "остальные операнды": "как в protection-coverage"
  },

  "values": [
    {
      "name": "noStageTwoReaction",
      "note": "Штатный проход не даёт биржевой ступени 2 ни на одном шаге.",
      "expr": "!invariantViolated"
    },
    {
      "name": "cancelTargetCandidates",
      "note": "Резолв объявленной цели снятия по цепочке замещений: живой потомок объявленной цели ровно один. Ноль означает, что снимать нечего; больше одного — цепочка разошлась.",
      "op": "count",
      "over": "protections",
      "where": "isLive && chainRoot == declaredCancelTarget",
      "of": "isLive"
    },
    {
      "name": "removalDeferred",
      "note": "Снятие отложено, а не отказано: покрытие снимаемой защиты пока не несёт никто другой.",
      "expr": "notNull(cancelTargetId) && !removalAllowed"
    }
  ],

  "examples": [
    {
      "case": "1. вход создан, отправки ещё не было — риска на бирже нет",
      "state": {
        "step": "PRECHECK / bull_entry CREATE",
        "position": { "externalSize": 0, "live": false },
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "CREATED", "kind": "STOP", "size": 3, "parentFillSize": 0 }
        ],
        "commitments": [],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "coverage": 0, "invariantViolated": false, "noStageTwoReaction": true }
    },
    {
      "case": "2. вход отправлен, факт не наблюдён — экспозиции ещё нет",
      "state": {
        "step": "SUBMIT bull_entry",
        "position": { "externalSize": 0, "live": false },
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "PENDING", "kind": "STOP", "size": 3, "parentFillSize": 0 }
        ],
        "commitments": [ { "terminal": false, "budgetExhausted": false } ],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "coverage": 0, "invariantViolated": false, "noStageTwoReaction": true }
    },
    {
      "case": "3. вход исполнен — экспозиция покрыта встроенным стопом с первого момента",
      "state": {
        "step": "ENTRY_FINALIZED",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "ACTIVE", "kind": "STOP", "size": 3, "parentFillSize": 3 }
        ],
        "commitments": [],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "coverage": 3, "coverageSufficient": true, "invariantViolated": false, "noStageTwoReaction": true }
    },
    {
      "case": "4. основная защита подтверждена — встроенную можно снимать",
      "state": {
        "step": "MAIN_PROTECTION bull_protection_oco подтверждён",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "ACTIVE", "kind": "STOP", "size": 3, "parentFillSize": 3 },
          { "id": "oco", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "STOP", "size": 3, "triggeredSize": 0 }
        ],
        "commitments": [],
        "cancelTargetId": "entry_sl",
        "declaredCancelTarget": "bull_entry"
      },
      "expect": { "coverage": 6, "coverageAfterRemoval": 3, "removalAllowed": true, "removalDeferred": false, "noStageTwoReaction": true }
    },
    {
      "case": "5. встроенная снята — покрытие несёт основная защита",
      "state": {
        "step": "MANAGING",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "entry_sl", "chainRoot": "bull_entry", "carrier": "ATTACHED", "status": "CANCELED", "kind": "STOP", "size": 3, "parentFillSize": 3 },
          { "id": "oco", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "STOP", "size": 3, "triggeredSize": 0 }
        ],
        "commitments": [],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "coverage": 3, "coverageSufficient": true, "invariantViolated": false, "noStageTwoReaction": true }
    },
    {
      "case": "6. безубыток: снятие старой защиты до подтверждения новой запрещено",
      "state": {
        "step": "PROTECTION_ADJUSTMENT bull_sl_to_breakeven создан, не подтверждён",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "oco", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "STOP", "size": 3, "triggeredSize": 0 },
          { "id": "breakeven", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "CREATED", "kind": "STOP", "size": 3, "triggeredSize": 0 }
        ],
        "commitments": [ { "terminal": false, "budgetExhausted": false } ],
        "cancelTargetId": "oco",
        "declaredCancelTarget": "bull_protection_oco"
      },
      "expect": { "coverage": 3, "coverageAfterRemoval": 0, "removalAllowed": false, "removalDeferred": true, "invariantViolated": false, "noStageTwoReaction": true }
