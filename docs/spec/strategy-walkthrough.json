        "removalDeferred": true,
        "invariantViolated": false,
        "noStageTwoReaction": true
      }
    },
    {
      "case": "9. трейлинг активирован — он несёт уровень, снятие безубытка разрешается",
      "state": {
        "step": "трейлинг наблюдён с уровнем",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "breakeven", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "STOP", "size": 3, "triggeredSize": 0 },
          { "id": "trailing", "chainRoot": "bull_trailing", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "TRAILING", "size": 3, "triggeredSize": 0, "activationPrice": 2040, "observedTrailingPrice": 2055 }
        ],
        "commitments": [],
        "cancelTargetId": "breakeven",
        "declaredCancelTarget": "bull_protection_oco"
      },
      "expect": { "coverage": 6, "coverageAfterRemoval": 3, "removalAllowed": true, "removalDeferred": false, "noStageTwoReaction": true }
    },
    {
      "case": "10. безубыток снят — покрытие несёт трейлинг",
      "state": {
        "step": "bull_oco_cancel исполнен",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "breakeven", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "CANCELED", "kind": "STOP", "size": 3, "triggeredSize": 0 },
          { "id": "trailing", "chainRoot": "bull_trailing", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "TRAILING", "size": 3, "triggeredSize": 0, "activationPrice": 2040, "observedTrailingPrice": 2055 }
        ],
        "commitments": [],
        "cancelTargetId": null,
        "declaredCancelTarget": null
      },
      "expect": { "coverage": 3, "coverageSufficient": true, "invariantViolated": false, "noStageTwoReaction": true }
