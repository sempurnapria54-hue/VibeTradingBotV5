    {
      "case": "7. безубыток подтверждён — старая защита снимается законно",
      "state": {
        "step": "bull_sl_to_breakeven подтверждён",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "oco", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "STOP", "size": 3, "triggeredSize": 0 },
          { "id": "breakeven", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "STOP", "size": 3, "triggeredSize": 0 }
        ],
        "commitments": [],
        "cancelTargetId": "oco",
        "declaredCancelTarget": "bull_protection_oco"
      },
      "expect": { "coverage": 6, "coverageAfterRemoval": 3, "removalAllowed": true, "removalDeferred": false, "noStageTwoReaction": true }
    },
    {
      "case": "8. трейлинг поставлен, но не активирован — снятие безубытка откладывается",
      "state": {
        "step": "bull_oco_cancel + bull_trailing",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "breakeven", "chainRoot": "bull_protection_oco", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "STOP", "size": 3, "triggeredSize": 0 },
          { "id": "trailing", "chainRoot": "bull_trailing", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "TRAILING", "size": 3, "triggeredSize": 0, "activationPrice": 2040, "observedTrailingPrice": null }
        ],
        "commitments": [ { "terminal": false, "budgetExhausted": false } ],
        "cancelTargetId": "breakeven",
        "declaredCancelTarget": "bull_protection_oco"
