    {
      "case": "11. выход по смене тренда: экспозиция ещё жива и остаётся покрытой",
      "state": {
        "step": "EXIT bull_exit отправлен",
        "position": { "externalSize": 3, "live": true },
        "protections": [
          { "id": "trailing", "chainRoot": "bull_trailing", "carrier": "STANDALONE", "status": "ACTIVE", "kind": "TRAILING", "size": 3, "triggeredSize": 0, "activationPrice": 2040, "observedTrailingPrice": 2055 }
        ],
        "commitments": [ { "terminal": false, "budgetExhausted": false } ],
        "cancelTargetId": null,
