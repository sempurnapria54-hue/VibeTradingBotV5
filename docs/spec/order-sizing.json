{
  "subject": "order-sizing",
  "question": "Какой размер получает действие",
  "home": "docs/components/SizeCalculator.md",

  "operands": {
    "base": "база риска",
    "instrument.contractValue": "размер контракта инструмента",
    "instrument.lotSize": "шаг размера",
    "instrument.minSize": "минимальный торговый размер",
    "instrument.takerFeeRate": "ставка комиссии как издержка",
    "entry.entryPrice": "цена входа действия",
    "entry.stopPrice": "уровень стопа действия",
    "entry.riskPerActionPercent": "поактный потолок риска, проценты",
    "entry.allocationPercents": "желаемая доля базы под нотинал, проценты",
    "position.externalSize": "Position.externalSize — нетто-размер живого эпизода; операнд агрегатных величин (доля выхода), не траншевых",
    "ladder.trancheExposure": "экспозиция транша, которому принадлежит набор ступеней; резолв — docs/spec/protection-coverage.json",
    "exit.fraction": "объявленная доля выхода",
    "ladder.previousStepsTotal": "сумма размеров уже поставленных ступеней набора",
    "ladder.declaredStepSize": "размер ступени по объявленной доле"
  },

  "values": [
    {
      "name": "perContractRisk",
      "note": "Закрытая форма сайзинга: убыток на стопе одного контракта с round-trip комиссией. ДОМ ФОРМЫ — эта спека: величина объявляется здесь и только здесь; спека, которой нужно ЗНАЧЕНИЕ, объявляет его операндом с указателем сюда, спека, которой нужна САМА ФОРМА на своих строках, подключает её через includes.",
      "expr": "(abs(entry.entryPrice - entry.stopPrice) + instrument.takerFeeRate * (entry.entryPrice + entry.stopPrice)) * instrument.contractValue"
    },
    {
      "name": "riskBudget",
      "expr": "entry.riskPerActionPercent / 100 * base"
    },
    {
      "name": "contractsFromRisk",
      "expr": "riskBudget / perContractRisk"
    },
    {
      "name": "contractsFromAllocation",
      "note": "Желаемый объём по доле аллокации; потолок риска — связывающий предел над ним.",
      "expr": "base * entry.allocationPercents / 100 / (entry.entryPrice * instrument.contractValue)"
    },
    {
      "name": "desiredContracts",
      "expr": "min(contractsFromRisk, contractsFromAllocation)"
    },
    {
      "name": "entryContracts",
      "note": "Округление вниз по шагу лота, снизу — минимальный торговый размер.",
      "expr": "max(floorTo(desiredContracts, instrument.lotSize), instrument.minSize)"
    },
    {
      "name": "entryRiskAtStop",
      "note": "Фактический риск ноги выбранного размера — операнд поактного неравенства.",
      "expr": "perContractRisk * entryContracts"
    },
    {
      "name": "entryWithinRiskBudget",
      "note": "Размер упёрся в минимум и всё равно выходит за потолок — вход блокирует преконтроль, а не калькулятор.",
      "expr": "entryRiskAtStop <= riskBudget"
    },

    {
      "name": "rawExitSize",
      "expr": "position.externalSize * exit.fraction"
    },
    {
      "name": "exitSize",
      "expr": "floorTo(rawExitSize, instrument.lotSize)"
    },
    {
      "name": "exitRemainder",
      "expr": "position.externalSize - exitSize"
    },
    {
      "name": "exitOutcome",
      "note": "Пола минимума у reduce-only выхода нет: подъём размера менял бы объявленное действие. Вместо пола — исходы округления. Полных выходов два, и они разведены значением: FULL_BY_FRACTION — объявленная доля забрала экспозицию целиком, ничего не округлялось, журнальный отчёт не заводится; FULL — «частично» на этом размере невыразимо, выход целиком объявляется отчётом PARTIAL_EXIT_ROUNDED_TO_FULL. Одно значение на оба исхода заставляло бы потребителя перевыводить exitSize >= minSize, чтобы решить, какой отчёт заводить.",
      "expr": "if(exitSize >= instrument.minSize, if(exitRemainder == 0, 'FULL_BY_FRACTION', 'PARTIAL'), if(exitRemainder < instrument.minSize, 'FULL', 'SKIPPED'))"
    },

    {
      "name": "lastLadderStepSize",
      "note": "Последняя ступень набора получает остаток: покрытие выходит ровно равным экспозиции ТРАНША. Нетто-размер позиции сюда не входит — на сетке он относится к нескольким траншам сразу, и последняя ступень каждого покрывала бы чужую экспозицию.",
      "expr": "ladder.trancheExposure - ladder.previousStepsTotal"
    },
    {
      "name": "ladderStepRejected",
      "note": "Ступень меньше минимального размера — явный отказ шага, а не тихий пропуск.",
      "expr": "ladder.declaredStepSize < instrument.minSize"
    }
  ],

  "examples": [
    {
      "case": "широкий стоп: размер связывает потолок риска",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 1, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 0 },
        "exit": { "fraction": 0 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expect": { "perContractRisk": 9.2955, "riskBudget": 100, "contractsFromAllocation": 33.33333333333333, "entryContracts": 10, "entryRiskAtStop": 92.955, "entryWithinRiskBudget": true }
    },
    {
      "case": "узкий стоп: связывает аллокация, а не потолок риска",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 1, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2997, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 0 },
        "exit": { "fraction": 0 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expect": { "entryContracts": 33, "entryWithinRiskBudget": true }
    },
    {
      "case": "размер упёрся в минимум и всё равно выходит за потолок — вход не проходит",
      "state": {
        "base": 100,
        "instrument": { "contractValue": 1, "lotSize": 1, "minSize": 5, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 0 },
        "exit": { "fraction": 0 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expect": { "entryContracts": 5, "entryWithinRiskBudget": false }
    },
    {
      "case": "частичный выход объявленной доли проходит штатно",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 1, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 10 },
        "exit": { "fraction": 0.5 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expect": { "exitSize": 5, "exitOutcome": "PARTIAL" }
    },
    {
      "case": "объявленная доля забрала экспозицию целиком — полный выход по доле, а не округление",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 1, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 10 },
        "exit": { "fraction": 1 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expect": { "exitSize": 10, "exitRemainder": 0, "exitOutcome": "FULL_BY_FRACTION" }
    },
    {
      "case": "доля меньше минимума, а остаток тоже меньше — выходим целиком и объявляем это",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 5, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 6 },
        "exit": { "fraction": 0.5 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expect": { "exitSize": 3, "exitRemainder": 3, "exitOutcome": "FULL" }
    },
    {
      "case": "доля меньше минимума, остаток достаточен — действие не исполняется",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 5, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 100 },
        "exit": { "fraction": 0.02 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expect": { "exitSize": 2, "exitRemainder": 98, "exitOutcome": "SKIPPED" }
    },
    {
      "case": "последняя ступень лестницы забирает остаток округления",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 1, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 103 },
        "exit": { "fraction": 0 },
        "ladder": { "trancheExposure": 103, "previousStepsTotal": 75, "declaredStepSize": 25 }
      },
      "expect": { "lastLadderStepSize": 28, "ladderStepRejected": false }
    },
    {
      "case": "сетка: последняя ступень транша считается от его экспозиции, а не от нетто-позиции",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 1, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 300 },
        "exit": { "fraction": 0 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 75, "declaredStepSize": 25 }
      },
      "expect": { "lastLadderStepSize": 25, "ladderStepRejected": false }
    },
    {
      "case": "ступень лестницы меньше минимального размера — отказ шага",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 5, "takerFeeRate": 0.0005 },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 12 },
        "exit": { "fraction": 0 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 9, "declaredStepSize": 3 }
      },
      "expect": { "ladderStepRejected": true }
    },
    {
      "case": "пустая ставка комиссии отказывает, а не считается нулём",
      "state": {
        "base": 10000,
        "instrument": { "contractValue": 0.1, "lotSize": 1, "minSize": 1, "takerFeeRate": null },
        "entry": { "entryPrice": 3000, "stopPrice": 2910, "riskPerActionPercent": 1, "allocationPercents": 100 },
        "position": { "externalSize": 0 },
        "exit": { "fraction": 0 },
        "ladder": { "trancheExposure": 100, "previousStepsTotal": 0, "declaredStepSize": 0 }
      },
      "expectRefusal": { "entryContracts": "ставка не резолвится" }
    }
  ]
}
