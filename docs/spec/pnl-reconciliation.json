{
  "subject": "pnl-reconciliation",
  "question": "Сошлась ли сверка P&L",
  "home": "docs/rules/pnl-reconciliation.md",
  "includes": ["risk-at-stop", "deal-risk-numbers", "protection-coverage", "order-lifecycle"],
  "operands": {
    "cashFlows[].amount": "DealCashFlow.amount — знаковая сумма движения",
    "cashFlows[].externalFee": "DealCashFlow.externalFee — знаковая комиссионная компонента записи, СЫРОЙ знак. Может отсутствовать: у события комиссионной компоненты не бывает (docs/models/domain/other/DealCashFlow.md)",
    "cashFlows[].ccy": "DealCashFlow.ccy",
    "cashFlows[].category": "DealCashFlow.category — экономическая либо принимающая корзина OTHER",
    "cashFlows[].excludedByExchange": "тип движения входит в список исключений сверки этой биржи",
    "settleCurrency": "расчётная валюта инструмента",
    "legs[].entryAnchor": "плановая цена входа ноги — себестоимость, от которой меряется её риск; операнд дома закрытой формы docs/spec/risk-at-stop.json, значение резолвится домом чисел риска (docs/spec/deal-risk-numbers.json)",
    "legs[].plannedStopPrice": "ПЛАНОВЫЙ уровень стопа ноги — операнд обратной задачи ставки комиссии (docs/spec/deal-risk-numbers.json, feeRate); с действующим уровнем stopPrice не совпадает и своим именем разведён намеренно",
    "legs[]": "ноги входа сделки с write-once числами планового риска",
    "episodes[]": "эпизоды позиции сделки — правая сторона всех четырёх пар",
    "episodes[].externalRealizedProfitGross": "Position.externalRealizedProfitGross — результат до издержек",
    "episodes[].externalFee": "Position.externalFee — знаковая комиссия, СЫРОЙ знак",
    "episodes[].externalFundingCost": "Position.externalFundingCost — финансирование, знак НОРМАЛИЗОВАН (издержка положительна)",
    "episodes[].externalLiquidationPenalty": "Position.externalLiquidationPenalty — штраф ликвидации, СЫРОЙ знак",
    "tolerance.relativeShare": "относительный член: доля валового оборота",
    "tolerance.omissionMultiplier": "омиссионный член: множитель ожидаемой комиссии сделки",
    "tolerance.floor": "пол допуска в расчётной валюте",
    "duty.closeRecordsFetchedForAllEpisodes": "записи закрытия добыты у всех эпизодов",
    "duty.windowClosed": "верхняя граница окна линковки непуста",
    "duty.flowsFetched": "добыча движений выполнялась"
  },
  "values": [
    {
      "name": "inReconciliationScope",
      "note": "Область сверки: расчётная валюта, вне списка исключений биржи, экономическая категория. Конъюнкция целиком.",
      "expr": "ccy == settleCurrency && !excludedByExchange && category != 'OTHER'"
    },
    {
      "name": "grossTurnover",
      "note": "Валовой оборот — якорь относительного члена. Обе стороны теста однородны по покрытию.",
      "op": "sum",
      "over": "cashFlows",
      "where": "inReconciliationScope",
      "of": "abs(amount)"
    },
    {
      "name": "legExpectedFee",
      "note": "Ожидаемая round-trip комиссия ноги, взвешенная филлом: комиссионный поток порождают филлы. Ни ставка, ни доля филла здесь не переписываются — обе берутся у дома чисел риска: docs/spec/deal-risk-numbers.json, величины feeRate и filledShare, подключённые через includes.",
      "expr": "feeRate * (entryAnchor + plannedStopPrice) * plannedSizeContracts * plannedContractValue * filledShare"
    },
    {
      "name": "expectedDealFee",
      "note": "Ожидаемая комиссия сделки. Множество ног — предикат взятого риска, а не заявленного. Бизнес-типы ноги входа здесь не переписываются: множество берётся у дома docs/spec/protection-coverage.json, величина isEntryOrder, через includes — подключение прямое, потому что includes нетранзитивен: дом, подключённый в deal-risk-numbers, отсюда не виден. По той же причине дом чисел риска подключён здесь напрямую: ставка ноги и доля её филла живут в нём. И по ней же подключён order-lifecycle: подключая набор protection-coverage, файл берёт его целиком, а часть величин того набора стоит на величинах жизненного цикла заявки.",
      "op": "sum",
      "over": "legs",
      "where": "isEntryOrder && accumulatedFillSize > 0 && notNull(plannedRiskAmount)",
      "of": "legExpectedFee"
    },
    {
      "name": "epsilon",
      "note": "Допуск один на сделку. Тест двухчастный, срабатывает меньший член; пол общий и вынесен наружу.",
      "expr": "max(tolerance.floor, min(tolerance.relativeShare * grossTurnover, tolerance.omissionMultiplier * expectedDealFee))"
    },
    {
      "name": "separateFeeGranularity",
      "note": "Источник эмитит комиссию отдельной записью. Различитель берётся из самих строк сделки — не из настройки и не из рантайм-факта: комиссионная строка расчётной валюты есть тогда и только тогда, когда гранулярность раздельная. Он снимает построчную неразличимость КОМБИНИРОВАННОЙ записи (balChg = pnl + fee) и ИНФОРМАЦИОННОГО ЭХА комиссии на торговой записи при раздельной гранулярности (balChg = pnl, при этом fee = -f): построчно обе формы выглядят как «сумма плюс непустая комиссия», на уровне сделки — различаются наличием комиссионной строки. ОБЛАСТЬ РАЗЛИЧИТЕЛЯ УЖЕ ОБЛАСТИ СВЕРКИ НА ОДИН КОНЪЮНКТ: список исключений биржи сюда НЕ входит намеренно — исключение комиссионного типа списком убрало бы комиссионные строки из области и сбило различитель в «комбинированная», после чего эхо вычиталось бы из торговой строки. Гранулярность есть свойство источника, а не области сверки.",
      "op": "exists",
      "over": "cashFlows",
      "where": "ccy == settleCurrency && in(category, 'TRADE_FEE', 'REBATE')"
    },
    {
      "name": "flowFeeComponent",
      "note": "Комиссионная компонента одной строки разбивки. У строки комиссионной категории ею служит само движение — это определение категории («отдельная запись списания/возврата комиссии», docs/models/mapping/DealCashFlow.md), а не подстановка по умолчанию. У прочих категорий компонента берётся явным полем — но только при комбинированной гранулярности: при раздельной то же поле на торговой записи есть эхо уже посчитанной комиссионной строки, и его учёт задваивал бы комиссию. Пустота поля означает «комиссионной компоненты у события нет» и в сумму не вносит ничего (docs/rules/absent-value-semantics.md).",
      "expr": "if(in(category, 'TRADE_FEE', 'REBATE'), amount, if(separateFeeGranularity, 0, coalesce(?externalFee, 0)))"
    },
    {
      "name": "flowAmountNetOfFee",
      "note": "Сумма строки за вычетом её комиссионной компоненты. Делает композицию левых сторон НЕЗАВИСИМОЙ ОТ ГРАНУЛЯРНОСТИ записи источника: комбинированная запись (balChg = pnl + fee одной строкой) и раздельная пара строк дают один результат. Без вычета комбинированная запись давала бы MISMATCHED величиной 2·|fee| на всей популяции. Пустое поле комиссии здесь читается нулём — «вычитать нечего», не «комиссия равна нулю» (docs/rules/absent-value-semantics.md).",
      "expr": "amount - flowFeeComponent"
    },
    {
      "name": "leftRealizedPnl",
      "op": "sum",
      "over": "cashFlows",
      "where": "inReconciliationScope && category == 'REALIZED_PNL'",
      "of": "flowAmountNetOfFee"
    },
    {
      "name": "leftTradeFee",
      "note": "Комиссия собирается по ВСЕЙ области сверки, а не по комиссионным категориям: у комбинированной записи она сидит внутри торговой строки и по категории не находится.",
      "op": "sum",
      "over": "cashFlows",
      "where": "inReconciliationScope",
      "of": "flowFeeComponent"
    },
    {
      "name": "leftFunding",
      "op": "sum",
      "over": "cashFlows",
      "where": "inReconciliationScope && category == 'FUNDING'",
      "of": "flowAmountNetOfFee"
    },
    {
      "name": "leftLiquidationPenalty",
      "op": "sum",
      "over": "cashFlows",
      "where": "inReconciliationScope && category == 'LIQ_PENALTY'",
      "of": "flowAmountNetOfFee"
    },
    {
      "name": "rightRealizedPnl",
      "op": "sum",
      "over": "episodes",
      "of": "externalRealizedProfitGross"
    },
    {
      "name": "rightTradeFee",
      "op": "sum",
      "over": "episodes",
      "of": "externalFee"
    },
    {
      "name": "rightFunding",
      "note": "Знак снимается обратно: домен хранит финансирование издержкой (положительной), а разбивка — сырой знаковой суммой. Сравнение идёт в СЫРОЙ конвенции, потому что у комиссии и штрафа знак сырой; смешение конвенций дало бы расхождение на всей популяции.",
      "op": "sum",
      "over": "episodes",
      "of": "0 - externalFundingCost"
    },
    {
      "name": "rightLiquidationPenalty",
      "op": "sum",
      "over": "episodes",
      "of": "externalLiquidationPenalty"
    },
    {
      "name": "discrepancyRealizedPnl",
      "note": "Пара считается как «слагаемые разбивки минус число записи закрытия», просуммированные по эпизодам.",
      "expr": "leftRealizedPnl - rightRealizedPnl"
    },
    {
      "name": "discrepancyTradeFee",
      "expr": "leftTradeFee - rightTradeFee"
    },
    {
      "name": "discrepancyFunding",
      "expr": "leftFunding - rightFunding"
    },
    {
      "name": "discrepancyLiquidationPenalty",
      "expr": "leftLiquidationPenalty - rightLiquidationPenalty"
    },
    {
      "name": "totalDiscrepancy",
      "note": "Общее расхождение по четырём парам: расхождения разных знаков друг друга не гасят.",
      "expr": "abs(discrepancyRealizedPnl) + abs(discrepancyTradeFee) + abs(discrepancyFunding) + abs(discrepancyLiquidationPenalty)"
    },
    {
      "name": "dutyArisen",
      "note": "Обязанность сверки — конъюнкция трёх условий.",
      "expr": "duty.closeRecordsFetchedForAllEpisodes && duty.windowClosed && duty.flowsFetched"
    },
    {
      "name": "matched",
      "note": "Сверка сошлась. Считается только при наступившей обязанности.",
      "expr": "dutyArisen && totalDiscrepancy <= epsilon"
    },
    {
      "name": "mismatched",
      "expr": "dutyArisen && totalDiscrepancy > epsilon"
    },
    {
      "name": "notRun",
      "note": "Сверка не была обязана: хотя бы один конъюнкт не выполнен.",
      "expr": "!dutyArisen"
    }
  ],
  "examples": [
    {
      "case": "расхождение в пределах допуска: относительный член связывает",
      "state": {
        "settleCurrency": "USDT",
