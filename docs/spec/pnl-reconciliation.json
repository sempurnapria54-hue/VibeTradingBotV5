            "category": "REALIZED_PNL",
            "excludedByExchange": false
          },
          {
            "amount": -0.5,
            "ccy": "USDT",
            "category": "TRADE_FEE",
            "excludedByExchange": false
          },
          {
            "amount": 2,
            "ccy": "USDT",
            "category": "FUNDING",
            "excludedByExchange": false
          }
        ],
        "legs": [
          {
            "type": "ENTRY",
            "plannedRiskAmount": 929.55,
            "plannedSizeContracts": 100,
            "accumulatedFillSize": 100,
            "entryAnchor": 3000,
            "plannedStopPrice": 2910,
            "plannedContractValue": 0.1
          }
        ],
        "episodes": [
          {
            "externalRealizedProfitGross": -100.2,
