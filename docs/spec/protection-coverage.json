{
  "subject": "protection-coverage",
  "question": "Каково покрытие защиты транша",
  "home": "docs/rules/live-risk-protection.md",
  "includes": ["order-lifecycle"],

  "operands": {
    "tranches[]": "транши сделки; у каждого свои заявки, защиты и обязательства",
    "tranches[].orders[].type": "ENTRY, ENTRY_ATTACHED_STOP_LOSS, REDUCE_ONLY",
    "tranches[].orders[].status": "Order.status",
    "tranches[].orders[].accumulatedFillSize": "Order.accumulatedFillSize в контрактах",
    "tranches[].protections[].carrier": "ATTACHED — Order.attachedAlgoOrders[*] входной заявки транша; STANDALONE — AlgoOrder транша",
    "tranches[].protections[].status": "AttachedAlgoOrder.status / AlgoOrder.status",
    "tranches[].protections[].kind": "STOP — фиксированный уровень; TRAILING — трейлинг; TAKE_PROFIT — тейк",
    "tranches[].protections[].size": "AttachedAlgoOrder.size / AlgoOrder.size",
    "tranches[].protections[].parentFillSize": "Order.accumulatedFillSize родительской заявки (только ATTACHED)",
    "tranches[].protections[].closedSize": "закрытый защитой объём: AlgoOrder.externalSize у standalone; size встроенной при терминальном срабатывании",
    "tranches[].protections[].activationPrice": "AlgoOrder.condition.trailing.activationPrice",
    "tranches[].protections[].observedTrailingPrice": "AlgoOrder.condition.trailing.externalPrice (moveTriggerPx)",
    "tranches[].commitments[].terminal": "DealActionState защитного действия транша — терминальна ли",
    "tranches[].commitments[].budgetExhausted": "бюджет попыток строки исчерпан",
    "deal.direction": "Deal.direction — LONG или SHORT: чем определяется, какой уровень менее благоприятен",
    "tranches[].protections[].stopLevel": "объявленный уровень остановки убытка этой защиты; у трейлинга уровень наблюдаемый, а не объявленный",
    "position.externalSize": "Position.externalSize живого эпизода — биржевой факт агрегата",
    "position.live": "Position.hasLiveRisk()",
    "cancelTargetId": "id снимаемой защиты — операнд преконтроля снятия"
  },

  "values": [
    {
      "name": "isEntryOrder",
      "expr": "in(type, 'ENTRY', 'ENTRY_ATTACHED_STOP_LOSS')"
    },
    {
      "name": "trancheEntryFilled",
      "note": "Сколько транш налил своими входными заявками.",
      "op": "sum",
      "over": "orders",
      "where": "isEntryOrder",
      "of": "accumulatedFillSize"
    },
    {
      "name": "trancheReduceOnlyFilled",
      "note": "Сколько транш закрыл своими reduce-only заявками.",
      "op": "sum",
      "over": "orders",
      "where": "type == 'REDUCE_ONLY'",
      "of": "accumulatedFillSize"
    },
    {
      "name": "trancheProtectionClosed",
      "note": "Сколько закрыли сработавшие защиты транша. У встроенной объём читается её размером — законно ровно потому, что инвариант требует покрытия филла целиком.",
      "op": "sum",
      "over": "protections",
      "of": "coalesce(?closedSize, 0)"
    },
    {
      "name": "trancheExposure",
      "note": "Экспозиция транша — производная его собственных заявок, а не накопитель: порядок событий на неё не влияет.",
      "expr": "trancheEntryFilled - trancheReduceOnlyFilled - trancheProtectionClosed"
    },
    {
      "name": "trancheHasLiveEntryOrder",
      "op": "any",
      "over": "orders",
      "of": "isEntryOrder && orderIsLive"
    },
    {
      "name": "trancheRiskBearing",
      "note": "Живой риск транша: экспозиция либо живая входная заявка.",
      "expr": "trancheExposure > 0 || trancheHasLiveEntryOrder"
    },
    {
      "name": "isLive",
      "note": "Живая защита. У встроенной множество уже; CREATED не входит нигде: заявка на бирже не подтверждена.",
      "expr": "if(carrier == 'ATTACHED', in(status, 'PENDING', 'ACTIVE'), in(status, 'PENDING', 'ACTIVE', 'PARTIALLY_COMPLETED'))"
    },
    {
      "name": "carriesActiveStopLevel",
      "note": "Несёт действующий уровень остановки убытка. Тейк не несёт никогда; трейлинг — только пока цена активации пуста либо уровень уже наблюдён.",
      "expr": "if(kind == 'TAKE_PROFIT', false, if(kind == 'TRAILING', isNull(?activationPrice) || notNull(?observedTrailingPrice), true))"
    },
    {
      "name": "isProtection",
      "note": "Заявка считается защитой.",
      "expr": "isLive && carriesActiveStopLevel"
    },
    {
      "name": "coveredSize",
      "note": "Сколько реально закрывает эта защита. У встроенной — не больше филла своей входной заявки; у standalone — остаток после срабатывания.",
      "expr": "if(carrier == 'ATTACHED', min(size, parentFillSize), size - coalesce(?closedSize, 0))"
    },
    {
      "name": "trancheCoverage",
      "note": "Совокупное покрытие транша: только его собственные защиты. Кросс-траншевых слагаемых в сумме нет по построению.",
      "op": "sum",
      "over": "protections",
      "where": "isProtection",
      "of": "coveredSize"
    },
    {
      "name": "trancheCovered",
      "note": "Инвариант: каждый транш закрыт своим стопом.",
      "expr": "trancheCoverage >= trancheExposure"
    },
    {
      "name": "hasLiveCommitment",
      "note": "Есть действующее обязательство покрытия транша: нетерминальная строка исполнения защитного действия с неисчерпанным бюджетом.",
      "op": "any",
      "over": "commitments",
      "of": "!terminal && !budgetExhausted"
    },
    {
      "name": "trancheViolated",
      "note": "Нарушение инварианта: экспозиция транша без покрытия и без обязательства. Реакция — биржевая ступень 2.",
      "expr": "trancheExposure > 0 && !trancheCovered && !hasLiveCommitment"
    },
    {
      "name": "coverageAfterRemoval",
      "note": "Покрытие транша после того, как снимаемая защита исчезнет. Операнд снятия тоже траншевый.",
      "op": "sum",
      "over": "protections",
      "where": "isProtection && id != cancelTargetId",
      "of": "coveredSize"
    },
    {
      "name": "removalAllowed",
      "note": "Снятие законно: покрытие снимаемой защиты уже несёт другая подтверждённая защита того же транша.",
      "expr": "coverageAfterRemoval >= trancheExposure"
    },
    {
      "name": "allTranchesCovered",
      "note": "Агрегатная достаточность выводится из траншевой, а не проверяется отдельно.",
      "op": "all",
      "over": "tranches",
      "of": "trancheCovered"
    },
    {
      "name": "anyTrancheViolated",
      "op": "any",
      "over": "tranches",
      "of": "trancheViolated"
    },
    {
      "name": "dealExposure",
      "op": "sum",
      "over": "tranches",
      "of": "trancheExposure"
    },
    {
      "name": "dealRiskBearing",
      "op": "any",
      "over": "tranches",
      "of": "trancheRiskBearing"
    },
    {
      "name": "exposureReconciled",
      "note": "Сверка модели с биржевым фактом: сумма экспозиций траншей равна нетто-позиции. Расхождение — живой риск, не приписанный ни одному траншу.",
      "expr": "dealExposure == position.externalSize"
    },

    {
      "name": "protectionStopLevel",
      "note": "Уровень остановки убытка одной защиты. У трейлинга он НАБЛЮДАЕМЫЙ: до первого наблюдения уровня нет, и величина пуста. Из isProtection такая защита выпадает только тогда, когда объявлена цена активации и та ещё не достигнута (carriesActiveStopLevel); трейлинг БЕЗ цены активации защищает сразу, в isProtection входит и уровня при этом не несёт — тогда trancheStopCurrent отказывает вычислением, а не берёт уровень у соседней защиты.",
      "expr": "if(kind == 'TRAILING', ?observedTrailingPrice, ?stopLevel)"
    },
    {
      "name": "trancheStopLowest",
      "note": "Нижний уровень среди ВСЕХ действующих защит транша, безотносительно носителя.",
      "op": "min", "over": "protections",
      "where": "isProtection",
      "of": "protectionStopLevel"
    },
    {
      "name": "trancheStopHighest",
      "note": "Верхний уровень среди ВСЕХ действующих защит транша, безотносительно носителя.",
      "op": "max", "over": "protections",
      "where": "isProtection",
      "of": "protectionStopLevel"
    },
    {
      "name": "trancheStopCurrent",
      "note": "Действующий уровень защиты транша — наименее благоприятный среди ВСЕХ его действующих защит: у LONG нижний, у SHORT верхний. Класс носителя (встроенная / отдельная / трейлинг) отбор не сужает: под лестницей разноуровневых защит и в окне двойной защиты часть экспозиции останавливается только на худшем уровне, и приоритет носителя занижал бы риск — ошибка в разрешающую сторону (docs/concept.md П1 §3). Защиты нет вовсе — пусто целиком, а не ноль. Защита, которая покрывает, но уровня ещё не наблюдала (трейлинг без цены активации до первого наблюдения), отказывает вычислением: подстановка чужого уровня вместо неизвестного была бы разрешающей ошибкой.",
      "expr": "if(deal.direction == 'LONG', trancheStopLowest, trancheStopHighest)"
    },
    {
      "name": "dealStopLowest",
      "op": "min", "over": "tranches",
      "where": "notNull(trancheStopCurrent)",
      "of": "trancheStopCurrent"
    },
    {
      "name": "dealStopHighest",
      "op": "max", "over": "tranches",
      "where": "notNull(trancheStopCurrent)",
      "of": "trancheStopCurrent"
    },
    {
      "name": "stopCurrentLive",
      "note": "Уровень на всю позицию — наименее благоприятный среди действующих защит всех траншей. Под лестницей разноуровневых защит оценка завышается: направление консервативное.",
      "expr": "if(deal.direction == 'LONG', dealStopLowest, dealStopHighest)"
    }
  ],

  "examples": [
    {
      "case": "встроенная защита на полностью налитой входной заявке покрывает свой транш",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [ { "id": "a1", "carrier": "ATTACHED", "kind": "STOP", "status": "ACTIVE", "size": 100, "parentFillSize": 100 } ],
            "commitments": []
          }
        ]
      },
      "expect": { "dealExposure": 100, "exposureReconciled": true, "allTranchesCovered": true, "anyTrancheViolated": false }
    },
    {
      "case": "встроенная защита капится филлом своей заявки, а не своим размером",
      "state": {
        "position": { "live": true, "externalSize": 30 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "PARTIALLY_COMPLETED", "accumulatedFillSize": 30 } ],
            "protections": [ { "id": "a1", "carrier": "ATTACHED", "kind": "STOP", "status": "ACTIVE", "size": 100, "parentFillSize": 30 } ],
            "commitments": []
          }
        ]
      },
      "expect": { "dealExposure": 30, "allTranchesCovered": true, "exposureReconciled": true }
    },
    {
      "case": "трейлинг до достижения цены активации защитой не считается",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [ { "id": "t1", "carrier": "STANDALONE", "kind": "TRAILING", "status": "ACTIVE", "size": 100, "closedSize": 0, "activationPrice": 3063, "observedTrailingPrice": null } ],
            "commitments": []
          }
        ]
      },
      "expect": { "allTranchesCovered": false, "anyTrancheViolated": true }
    },
    {
      "case": "трейлинг без цены активации защищает сразу",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [ { "id": "t1", "carrier": "STANDALONE", "kind": "TRAILING", "status": "ACTIVE", "size": 100, "closedSize": 0, "activationPrice": null, "observedTrailingPrice": null } ],
            "commitments": []
          }
        ]
      },
      "expect": { "allTranchesCovered": true, "anyTrancheViolated": false }
    },
    {
      "case": "активированный трейлинг покрывает: уровень наблюдён",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [ { "id": "t1", "carrier": "STANDALONE", "kind": "TRAILING", "status": "ACTIVE", "size": 100, "closedSize": 0, "activationPrice": 3063, "observedTrailingPrice": 3120 } ],
            "commitments": []
          }
        ]
      },
      "expect": { "allTranchesCovered": true }
    },
    {
      "case": "тейк покрытием не является ни при каком статусе",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [ { "id": "p1", "carrier": "STANDALONE", "kind": "TAKE_PROFIT", "status": "ACTIVE", "size": 100, "closedSize": 0 } ],
            "commitments": []
          }
        ]
      },
      "expect": { "anyTrancheViolated": true }
    },
    {
      "case": "частично сработавшая standalone-защита покрывает остаток своего транша",
      "state": {
        "position": { "live": true, "externalSize": 60 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [ { "id": "s1", "carrier": "STANDALONE", "kind": "STOP", "status": "PARTIALLY_COMPLETED", "size": 100, "closedSize": 40 } ],
            "commitments": []
          }
        ]
      },
      "expect": { "dealExposure": 60, "exposureReconciled": true, "allTranchesCovered": true }
    },
    {
      "case": "CREATED не покрывает: подтверждения с биржи нет",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [ { "id": "s1", "carrier": "STANDALONE", "kind": "STOP", "status": "CREATED", "size": 100, "closedSize": 0 } ],
            "commitments": [ { "terminal": false, "budgetExhausted": false } ]
          }
        ]
      },
      "expect": { "allTranchesCovered": false, "anyTrancheViolated": false }
    },
    {
      "case": "пакет шага транша: снятие OCO при неактивированном трейлинге не допускается",
      "note": "Состояние примера — один транш: операнды снятия траншевые, соседние транши в них не входят.",
      "state": {
        "cancelTargetId": "oco",
        "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
        "protections": [
          { "id": "oco", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 100, "closedSize": 0 },
          { "id": "trl", "carrier": "STANDALONE", "kind": "TRAILING", "status": "ACTIVE", "size": 100, "closedSize": 0, "activationPrice": 3063, "observedTrailingPrice": null }
        ],
        "commitments": []
      },
      "expect": { "trancheExposure": 100, "trancheCoverage": 100, "coverageAfterRemoval": 0, "removalAllowed": false, "trancheViolated": false }
    },
    {
      "case": "тот же пакет транша после активации трейлинга: снятие допускается",
      "state": {
        "cancelTargetId": "oco",
        "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
        "protections": [
          { "id": "oco", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 100, "closedSize": 0 },
          { "id": "trl", "carrier": "STANDALONE", "kind": "TRAILING", "status": "ACTIVE", "size": 100, "closedSize": 0, "activationPrice": 3063, "observedTrailingPrice": 3120 }
        ],
        "commitments": []
      },
      "expect": { "coverageAfterRemoval": 100, "removalAllowed": true }
    },
    {
      "case": "перевыставление входа транша: новая заявка с нулевым филлом покрытия не даёт, старая ещё несёт",
      "state": {
        "position": { "live": true, "externalSize": 30 },
        "tranches": [
          {
            "orders": [
              { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "CANCELED", "accumulatedFillSize": 30 },
              { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "ACTIVE", "accumulatedFillSize": 0 }
            ],
            "protections": [
              { "id": "old", "carrier": "ATTACHED", "kind": "STOP", "status": "ACTIVE", "size": 100, "parentFillSize": 30 },
              { "id": "new", "carrier": "ATTACHED", "kind": "STOP", "status": "PENDING", "size": 70, "parentFillSize": 0 }
            ],
            "commitments": []
          }
        ]
      },
      "expect": { "dealExposure": 30, "allTranchesCovered": true, "exposureReconciled": true }
    },
    {
      "case": "лестница частичных стопов транша на 25+25+25+15 его экспозицию не покрывает",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [
              { "id": "l1", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 25, "closedSize": 0 },
              { "id": "l2", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 25, "closedSize": 0 },
              { "id": "l3", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 25, "closedSize": 0 },
              { "id": "l4", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 15, "closedSize": 0 }
            ],
            "commitments": []
          }
        ]
      },
      "expect": { "allTranchesCovered": false, "anyTrancheViolated": true }
    },
    {
      "case": "лестница, где последняя ступень получила остаток, покрывает экспозицию транша ровно",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [
              { "id": "l1", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 25, "closedSize": 0 },
              { "id": "l2", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 25, "closedSize": 0 },
              { "id": "l3", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 25, "closedSize": 0 },
              { "id": "l4", "carrier": "STANDALONE", "kind": "STOP", "status": "ACTIVE", "size": 25, "closedSize": 0 }
            ],
            "commitments": []
          }
        ]
      },
      "expect": { "allTranchesCovered": true, "anyTrancheViolated": false }
    },
    {
      "case": "недопокрытие под живым обязательством транша нарушением не является",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [],
            "commitments": [ { "terminal": false, "budgetExhausted": false } ]
          }
        ]
      },
      "expect": { "allTranchesCovered": false, "anyTrancheViolated": false }
    },
    {
      "case": "недопокрытие при исчерпанном бюджете обязательства — нарушение",
      "state": {
        "position": { "live": true, "externalSize": 100 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 100 } ],
            "protections": [],
            "commitments": [ { "terminal": false, "budgetExhausted": true } ]
          }
        ]
      },
      "expect": { "anyTrancheViolated": true }
    },
    {
      "case": "грид: полный налив, частичный налив и ненаступивший уровень — все транши покрыты, сумма сходится с нетто-позицией",
      "state": {
        "position": { "live": true, "externalSize": 8 },
        "tranches": [
          {
            "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 5 } ],
            "protections": [ { "id": "l0_sl", "carrier": "ATTACHED", "kind": "STOP", "status": "ACTIVE", "size": 5, "parentFillSize": 5 } ],
            "commitments": []
          },
          {
            "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "PARTIALLY_COMPLETED", "accumulatedFillSize": 3 } ],
            "protections": [ { "id": "l1_sl", "carrier": "ATTACHED", "kind": "STOP", "status": "ACTIVE", "size": 5, "parentFillSize": 3 } ],
            "commitments": []
