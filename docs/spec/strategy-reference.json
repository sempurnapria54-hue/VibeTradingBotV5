{
  "subject": "strategy-reference",
  "question": "Проходит ли эталонная стратегия репозитория действующие требования к дереву стратегии",
  "home": "docs/rules/strategy-validation.md",
  "includes": ["stop-distance", "protection-coverage", "order-lifecycle"],
  "operands": {
    "strategy": "src/main/resources/strategy-examples/trend-following-ema.json — исполнимый эталон",
    "details[].phaseEntryPolicy": "политика входа в фазе; NO_TRADE — неторгуемая деталь",
    "details[].stepsByStatus{}": "шаги, сгруппированные по статусу сделки",
    "steps[].actions[]": "пакет действий шага",
    "feeRate": "прогнозная ставка комиссии — операнд величин уровня стопа, заимствованных у docs/spec/stop-distance.json вместе с её набором. Здесь он объявлен контрактом, а не подключением дома: одноимённая величина docs/spec/deal-risk-numbers.json — ДРУГАЯ ставка (обращённая из замороженных плановых чисел ноги), и подключение того дома подменило бы смысл",
    "steps[].actions[].replacedCoverageFractionPercents": "доля ДЕЙСТВУЮЩЕГО покрытия, которую адресует это REPLACE- либо CANCEL-действие: объявленная доля его цели, резолвимой по targetActionKey (цепочка замещений — docs/rules/replace-not-amend.md). Цель защитой не является (снятие тейка) — покрытия действие не забирает, доля 0. Пусто — цель не разрешена; тогда действие считается адресующим ВСЁ покрытие: неизвестность не должна выводить шаг из-под проверки. Резолв по ключу — работа валидатора создания; в этой форме join по ключу невыразим, поэтому свойства цели приходят операндом",
    "details[].tranches[].levelCount": "сколько одновременно живых траншей объявляет эта запись; умолчания нет — пустое место мажорировалось бы единицей, то есть в разрешающую сторону",
    "globalSimultaneousRiskPerDealPercent": "глобальный потолок одновременного риска на сделку — максимальный риск на сделку (конфигурация)",
    "globalCatastrophicRiskPerDealMultiplier": "максимальный множитель катастрофического потолка (конфигурация)"
  },
  "values": [
    {
      "name": "isTradableDetail",
      "expr": "phaseEntryPolicy != 'NO_TRADE'"
    },
    {
      "name": "hasRequiredRiskFields",
      "note": "У торгуемой детали риск-поля обязательны и умолчаний не имеют. Признак переоткрытия сюда не входит: он свойство транша.",
      "expr": "notNull(?riskPerActionPercent) && notNull(?cumulativeRiskPerDealMultiplier) && notNull(?strategySimultaneousRiskPerDealPercent) && notNull(?strategyCatastrophicRiskPerDealMultiplier)"
    },
    {
      "name": "detailTrancheCount",
      "op": "count",
      "over": "tranches"
    },
    {
      "name": "trancheDeclaresReopen",
      "note": "Признак переоткрытия объявляет транш, и умолчания у него нет.",
      "op": "all",
      "over": "tranches",
      "of": "notNull(?positionReopenAllowed)"
    },
    {
      "name": "tradableDetailsWithTranches",
      "note": "Торгуемая деталь обязана объявить хотя бы один транш: без него у неё нет входа.",
      "op": "count",
      "over": "strategy.details[]",
      "where": "isTradableDetail && detailTrancheCount > 0 && trancheDeclaresReopen"
    },
    {
      "name": "trancheEntryActions",
      "note": "Входные действия одного транша.",
      "op": "count",
      "over": "stepsByStatus{}[].actions[]",
      "where": "actionKind == 'ORDER' && in(?orderType, 'ENTRY', 'ENTRY_ATTACHED_STOP_LOSS')"
    },
    {
      "name": "tranchesWithSingleEntry",
      "note": "У транша ровно одно входное объявление: живая входная заявка у него не более одной.",
      "op": "count",
      "over": "strategy.details[].tranches[]",
      "where": "trancheEntryActions == 1"
    },
    {
      "name": "tranchesCount",
      "op": "count",
      "over": "strategy.details[].tranches[]"
    },
    {
      "name": "dealLevelStepTypeAllowed",
      "note": "Агрегатная поверхность узкая: на детали объявляются только выход и аварийный шаг.",
      "expr": "in(stepType, 'EXIT', 'FAIL_SAFE')"
    },
    {
      "name": "dealLevelStepsOutOfScope",
      "op": "count",
      "over": "strategy.details[].stepsByStatus{}[]",
      "where": "!dealLevelStepTypeAllowed"
    },
    {
      "name": "usesLegacyActionLevel",
      "note": "Уровень сетки уехал на транш; маркер на действии — дефект артефакта.",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[].actions[]",
      "where": "notNull(?level)"
    },
    {
      "name": "usesLegacyRiskFieldName",
      "note": "Имя поактного потолка разведено суффиксом уровня; безсуффиксное riskPerTradePercent в дереве стратегии — дефект артефакта.",
      "expr": "notNull(?riskPerTradePercent)"
    },
    {
      "name": "tradableDetailsCount",
      "op": "count",
      "over": "strategy.details[]",
      "where": "isTradableDetail"
    },
    {
      "name": "tradableDetailsWithRiskFields",
      "op": "count",
      "over": "strategy.details[]",
      "where": "isTradableDetail && hasRequiredRiskFields"
    },
    {
      "name": "detailsWithLegacyRiskFieldName",
      "op": "count",
      "over": "strategy.details[]",
      "where": "usesLegacyRiskFieldName"
    },
    {
      "name": "riskFieldsComplete",
      "expr": "tradableDetailsWithRiskFields == tradableDetailsCount && detailsWithLegacyRiskFieldName == 0"
    },
    {
      "name": "strategyRiskWithinGlobal",
      "note": "Первое неравенство создания: максимум одновременного риска стратегии не выше конфигурационного. Свой реджект — STRATEGY_SIMULTANEOUS_RISK_ABOVE_GLOBAL.",
      "expr": "strategySimultaneousRiskPerDealPercent <= globalSimultaneousRiskPerDealPercent"
    },
    {
      "name": "catastrophicMultiplierWithinGlobal",
      "note": "Третье неравенство создания: множитель катастрофического потолка не выше конфигурационного. Свой реджект — STRATEGY_CATASTROPHIC_MULTIPLIER_ABOVE_GLOBAL.",
      "expr": "strategyCatastrophicRiskPerDealMultiplier <= globalCatastrophicRiskPerDealMultiplier"
    },
    {
      "name": "riskChainHolds",
      "note": "Первое и третье неравенства создания, названные домом одной величиной (docs/rules/strategy-validation.md, перечень исключений). Реджекты у них РАЗНЫЕ, поэтому каждое стои́т отдельной величиной выше: адресует отказ тот конъюнкт, который ложен. Неравенство «поактный ≤ максимум стратегии» сюда не входит вовсе: это случай N_overlap = 1 второго неравенства, у которого свой операнд, свой реджект ..._UNSATISFIABLE и своя величина overlapRiskSatisfiable — слияние отобрало бы у отказа адресность.",
      "expr": "strategyRiskWithinGlobal && catastrophicMultiplierWithinGlobal"
    },
    {
      "name": "detailsBreakingRiskChain",
      "op": "count",
      "over": "strategy.details[]",
      "where": "isTradableDetail && !riskChainHolds"
    },
    {
      "name": "detailOverlapCount",
      "note": "N_overlap — число одновременно живых траншей детали: сумма levelCount по её объявлениям. Транши объявлены, поэтому число считается, а не мажорируется обходом дерева шагов.",
      "op": "sum",
      "over": "tranches",
      "of": "levelCount"
    },
    {
      "name": "overlapRiskSatisfiable",
      "note": "Веер детали умещается в её же потолок одновременного риска: N_overlap × поактный ≤ максимум стратегии. Проверка консервативна и это названо — она мажорирует сумму произведением. Реджект собственный: STRATEGY_SIMULTANEOUS_RISK_UNSATISFIABLE.",
      "expr": "detailOverlapCount * riskPerActionPercent <= strategySimultaneousRiskPerDealPercent"
    },
    {
      "name": "detailsBreakingOverlap",
      "op": "count",
      "over": "strategy.details[]",
      "where": "isTradableDetail && !overlapRiskSatisfiable"
    },
    {
      "name": "actionTypeKnown",
      "note": "Словарь типов действия — с суффиксом уровня.",
      "expr": "in(actionType, 'CREATE_ACTION', 'REPLACE_ACTION', 'CANCEL_ACTION', 'EXIT_ACTION')"
    },
    {
      "name": "actionsWithUnknownType",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[].actions[]",
      "where": "!actionTypeKnown"
    },
    {
      "name": "isProtectiveAction",
      "note": "Защитное действие: условная заявка типа из множества защит. Селектор годится там, где тип условия — СОБСТВЕННОЕ свойство действия, то есть у создающего и у замещающего: они объявляют, какую заявку ставят. У снимающего тип условия — денормализованная копия типа его цели, совпадение с оригиналом не проверяется, и решение на копии стоять не может: что действие ЗАБИРАЕТ, читается у цели (stepReplacedCoverage, stepHasProtectiveCancel). Поле обязательно у любого действия над условной заявкой (docs/rules/strategy-validation.md), поэтому пустым здесь оно не бывает.",
      "expr": "actionKind == 'ALGO_ORDER' && in(?conditionType, 'STOP_LOSS', 'PARTIAL_STOP_LOSS', 'OCO_FULL', 'TRAILING_PERCENTS', 'TRAILING_VALUE')"
    },
    {
      "name": "stepProtectiveCoverage",
      "note": "Сумма долей защитных CREATE и REPLACE шага.",
      "op": "sum",
      "over": "actions",
      "where": "isProtectiveAction && in(actionType, 'CREATE_ACTION', 'REPLACE_ACTION')",
      "of": "coalesce(?closeFractionPercents, 0)"
    },
    {
      "name": "stepHasProtectiveCancel",
      "note": "Шаг снимает действующее покрытие. Защита ли снимаемое — свойство ЦЕЛИ снятия, а не самого снятия: собственный conditionType снятия лишь копирует тип цели, и разошедшаяся копия выводила бы шаг из-под проверки. Снятие тейка покрытия не забирает (адресованная доля 0) и замены не требует.",
      "op": "any",
      "over": "actions",
      "of": "actionKind == 'ALGO_ORDER' && actionType == 'CANCEL_ACTION' && coalesce(?replacedCoverageFractionPercents, 100) > 0"
    },
    {
      "name": "stepReplacedCoverage",
      "note": "Сколько действующего покрытия шаг адресует своими REPLACE и CANCEL. Отбор идёт по ФОРМЕ действия — условная заявка, замещающая либо снимающая, — а не по его собственному conditionType: что действие ЗАБИРАЕТ, есть свойство его ЦЕЛИ, а собственный тип условия снимающего действия — лишь копия типа цели, согласованность которой с оригиналом никто не проверяет. Копия, разошедшаяся с целью, выводила бы шаг из-под всех проверок покрытия сразу, поэтому решение стои́т на доле, прочитанной у цели. Цель не защита (снятие тейка) — адресованная доля покрытия 0, и такое снятие шага не задевает. Пустая доля цели читается сотней: цель не разрешилась, и трактовать это как «адресует мало» значило бы вывести шаг из-под проверки благоприятным умолчанием.",
      "op": "sum",
      "over": "actions",
      "where": "actionKind == 'ALGO_ORDER' && in(actionType, 'REPLACE_ACTION', 'CANCEL_ACTION')",
      "of": "coalesce(?replacedCoverageFractionPercents, 100)"
    },
    {
      "name": "stepDeclaresFullProtectionSet",
      "note": "Полный набор: первичная постановка защиты либо шаг, адресующий ВСЁ действующее покрытие — снятием, замещением или их смесью. Признак — сколько покрытия шаг забирает, а не каким типом действия: REPLACE, замещающий одну ступень лестницы из четырёх по 25 %, забирает 25 и полного набора не объявляет — после него остальные три ступени продолжают стоять, поэтому требовать от него сотни значило бы отвергать конфигурацию, которую дом объявляет законной. REPLACE, замещающий единственную защиту на 100 %, забирает всё и обязан вернуть столько же. Шаг, забирающий часть, из-под проверки не выходит: его связывает соседнее требование stepReturnsLessThanReplaced — возвращено не меньше забранного.",
      "expr": "stepType == 'MAIN_PROTECTION' || stepReplacedCoverage >= 100"
    },
    {
      "name": "stepCoverageComplete",
      "note": "Равенство, а не нижняя граница, и это намеренно: доли считаются от одной и той же позиции, поэтому сумма выше ста процентов — не усиленная защита, а невыполнимое объявление (закрыть больше, чем есть). Дом довода — docs/rules/live-risk-protection.md.",
      "expr": "stepProtectiveCoverage == 100"
    },
    {
      "name": "fullSetStepsCount",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[]",
      "where": "stepDeclaresFullProtectionSet"
    },
    {
      "name": "fullSetStepsWithCompleteCoverage",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[]",
      "where": "stepDeclaresFullProtectionSet && stepCoverageComplete"
    },
    {
      "name": "protectionCoverageComplete",
      "expr": "fullSetStepsWithCompleteCoverage == fullSetStepsCount"
    },
    {
      "name": "stepHasReplacementForCancel",
      "note": "Снятие защиты законно только вместе с заменой в том же пакете: порядок пакета по риск-классу ставит установку раньше снятия.",
      "op": "any",
      "over": "actions",
      "of": "isProtectiveAction && in(actionType, 'CREATE_ACTION', 'REPLACE_ACTION')"
    },
    {
      "name": "stepReturnsLessThanReplaced",
      "note": "Шаг забирает ЧАСТЬ действующего покрытия и возвращает меньше, чем забрал. Покрытие после шага = действующее − забранное + объявленное, поэтому такой шаг опускает его ниже ста процентов при любом рынке: снял ступень на 25 % и поставил взамен 10 % — осталось 85. Соседние предикаты этого не ловят: полного набора шаг не объявляет, а замена в пакете у него есть. Шаг, забирающий ВСЁ, проверяется не здесь, а равенством ста процентам (stepCoverageComplete): там же гасится завышение суммы забранного, которое даёт консервативное умолчание неразрешённой цели.",
      "expr": "!stepDeclaresFullProtectionSet && stepProtectiveCoverage < stepReplacedCoverage"
    },
    {
      "name": "partialStepsReturningLess",
      "note": "Счётчик нарушителей. Реджект тот же — STRATEGY_PROTECTION_COVERAGE_INCOMPLETE: класс один — покрытие после шага ниже ста процентов.",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[]",
      "where": "stepReturnsLessThanReplaced"
    },
    {
      "name": "cancelStepsWithoutReplacement",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[]",
      "where": "stepHasProtectiveCancel && !stepHasReplacementForCancel"
    },
    {
      "name": "entryActionsWithoutAttachedProtection",
      "note": "Risk-creating вход без встроенной защиты до биржи не доходит.",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[].actions[]",
      "where": "actionKind == 'ORDER' && ?orderType == 'ENTRY_ATTACHED_STOP_LOSS' && isNull(?attachedProtection)"
    },
    {
      "name": "allocationOutOfRange",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[].actions[]",
      "where": "notNull(?allocationPercents) && (allocationPercents < 0 || allocationPercents > 100)"
    },
    {
      "name": "actionStopCalculationType",
      "note": "Способ расчёта уровня, объявленный этим действием: своими настройками стопа либо настройками встроенной защиты входа.",
      "expr": "coalesce(?stopLossSettings.calculationType, ?attachedProtection.stopLossSettings.calculationType)"
    },
    {
      "name": "actionIsLevelTransfer",
      "note": "Действие ПЕРЕНОСИТ уже стоящий уровень: защитный REPLACE с названной целью. Всё прочее — первичная постановка (встроенная защита входа, первичная защитная заявка), то есть placementRole = PRIMARY.",
      "expr": "actionKind == 'ALGO_ORDER' && actionType == 'REPLACE_ACTION' && notNull(?targetActionKey)"
    },
    {
      "name": "breakevenAsPrimaryStop",
      "note": "Объявления BREAKEVEN не в роли переноса. Правило и довод — дом docs/spec/stop-distance.json, величина breakevenRoleAllowed; здесь роль выводится из формы действия дерева стратегии. Реджект создания — STRATEGY_BREAKEVEN_NOT_A_TRANSFER.",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[].actions[]",
      "where": "actionStopCalculationType == 'BREAKEVEN' && !actionIsLevelTransfer"
    },
    {
      "name": "stopSettingsMisdeclared",
      "note": "Объявления уровня стопа в защитных действиях транша: способ расчёта — из закрытого перечня, доля дистанции согласована со способом (у BREAKEVEN не объявляется). Предикаты — дом docs/spec/stop-distance.json.",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[].actions[].stopLossSettings",
      "where": "!calculationTypeKnown || !distanceDeclaredWhenNeeded"
    },
    {
      "name": "attachedStopSettingsMisdeclared",
      "note": "То же для встроенной защиты входной заявки.",
      "op": "count",
      "over": "strategy.details[].tranches[].stepsByStatus{}[].actions[].attachedProtection.stopLossSettings",
      "where": "!calculationTypeKnown || !distanceDeclaredWhenNeeded"
    },
    {
      "name": "detailsCount",
      "op": "count",
      "over": "strategy.details[]"
    }
  ],
  "examples": [
    {
      "case": "эталонная стратегия объявляет деталь на каждый тип фазы",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "detailsCount": 4,
        "tradableDetailsCount": 2
      }
    },
    {
      "case": "у торгуемых деталей эталона заполнены все риск-поля действующей модели",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "tradableDetailsWithRiskFields": 2,
        "detailsWithLegacyRiskFieldName": 0,
        "riskFieldsComplete": true
      }
    },
    {
      "case": "каждая торгуемая деталь эталона объявляет транш, и транш объявляет признак переоткрытия",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "tradableDetailsWithTranches": 2,
        "tranchesCount": 2
      }
    },
    {
      "case": "у каждого транша эталона ровно одно входное объявление",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "tranchesWithSingleEntry": 2
      }
    },
    {
      "case": "агрегатная поверхность эталона несёт только выход",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "dealLevelStepsOutOfScope": 0
      }
    },
    {
      "case": "маркера уровня на действиях эталона не осталось: уровень уехал на транш",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "usesLegacyActionLevel": 0
      }
    },
    {
      "case": "типы действий эталона — из действующего словаря",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "actionsWithUnknownType": 0
      }
    },
    {
      "case": "каждый шаг эталона, объявляющий полный набор защиты, покрывает позицию целиком; под проверку попадают все шесть — по три на торгуемую деталь: первичная постановка, безубыток замещением и перевод на трейлинг снятием",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
      },
      "expect": {
        "fullSetStepsCount": 6,
        "fullSetStepsWithCompleteCoverage": 6,
        "protectionCoverageComplete": true
      }
    },
    {
      "case": "замещается ВСЁ действующее покрытие, и возвращается только 60 % — конфигурация отвергается созданием",
      "state": {
        "strategy": {
