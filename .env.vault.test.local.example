# Local Vault token for booting the `test` profile from the shell.
#
# This is a SHELL-SOURCED file (note the `export` below), NOT a docker-compose
# env_file like .env.test.local / .env.prod.local. tools/boot-test.sh sources
# it before `mvn spring-boot:run`, so VAULT_TOKEN reaches the app process.
#
# Setup:
#   1. cp .env.vault.test.local.example .env.vault.test.local
#   2. Paste a TEST-scoped Vault token into .env.vault.test.local.
#
# The token MUST be limited to the test secret paths only:
#   secret/tradingbot/postgres-test
#   secret/tradingbot/okx-test
# Do NOT use a root token or any token that can read the prod paths
# (secret/tradingbot/postgres, secret/tradingbot/okx). The test profile never
# touches prod secrets; scoping the token keeps prod unreachable from this boot.
#
# .env.vault.test.local is gitignored — it stays out of git. This .example
# template is committed.

export VAULT_TOKEN="<paste-test-scoped-vault-token-here>"

# Optional: override the Vault address. Defaults to http://localhost:8200
# (application.yaml: ${VAULT_URI:http://localhost:8200}).
# export VAULT_URI="http://localhost:8200"
