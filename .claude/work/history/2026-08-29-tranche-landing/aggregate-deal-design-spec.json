        "to": "ERROR",
        "deal": { "status": "ACTIVE" },
        "position": { "externalSize": 8, "live": true },
        "tranches": [
          { "status": "MANAGING", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 8 } ], "protections": [], "commitments": [] }
        ]
