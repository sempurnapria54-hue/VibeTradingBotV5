    {
      "case": "выход транша объявлен из сопровождения — ребро есть и при запрещённом переоткрытии",
      "state": {
        "from": "MANAGING",
        "to": "EXIT_PENDING",
        "reopenAllowed": false,
        "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 5 } ],
        "protections": []
      },
      "expect": { "trancheEdgeDeclared": true, "trancheTransitionAllowed": true }
    },
    {
      "case": "у транша нет ребра в ошибочный статус: отказ поднимается в агрегат",
      "state": {
        "from": "MANAGING",
        "to": "ERROR",
        "reopenAllowed": false,
        "orders": [],
        "protections": []
      },
      "expect": { "trancheEdgeDeclared": false }
    },
    {
      "case": "агрегат уходит в остановку из сопровождения — ребро объявлено",
