        ]
      },
      "expect": { "newRiskAllowed": false }
    },
    {
      "case": "недопокрытие транша под его живым обязательством нарушением не является",
      "state": {
        "deal": { "status": "ACTIVE" },
        "position": { "externalSize": 3, "live": true },
        "cancelTargetId": null,
        "tranches": [
          {
            "status": "ENTRY_FINALIZED",
            "reopenAllowed": false,
            "orders": [ { "type": "ENTRY", "status": "COMPLETED", "accumulatedFillSize": 3 } ],
            "protections": [],
            "commitments": [ { "terminal": false, "budgetExhausted": false } ]
          }
        ]
      },
      "expect": { "dealExposure": 3, "allTranchesCovered": false, "anyTrancheViolated": false }
    },
    {
      "case": "эталонная стратегия репозитория переводится одним траншем на торгуемую деталь",
      "stateFrom": {
        "strategy": "src/main/resources/strategy-examples/trend-following-ema.json"
