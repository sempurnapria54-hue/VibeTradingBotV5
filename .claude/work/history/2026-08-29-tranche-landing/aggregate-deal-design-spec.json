    {
      "case": "терминал агрегата при живом транше не применяется",
      "state": {
        "from": "EXIT_PENDING",
        "to": "CLOSED",
        "deal": { "status": "EXIT_PENDING" },
        "position": { "externalSize": 3, "live": true },
        "tranches": [
          { "status": "CLOSED", "orders": [], "protections": [], "commitments": [] },
          { "status": "EXIT_PENDING", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 3 } ], "protections": [], "commitments": [] }
        ]
      },
      "expect": { "allTranchesTerminal": false, "dealRiskBearing": true, "aggregateEdgeDeclared": true, "aggregateTransitionAllowed": false }
    },
    {
      "case": "терминал агрегата применяется, когда все транши закрыты и живого риска нет",
      "state": {
        "from": "EXIT_PENDING",
        "to": "CLOSED",
        "deal": { "status": "EXIT_PENDING" },
        "position": { "externalSize": 0, "live": false },
        "tranches": [
          { "status": "CLOSED", "orders": [ { "type": "ENTRY_ATTACHED_STOP_LOSS", "status": "COMPLETED", "accumulatedFillSize": 5 }, { "type": "REDUCE_ONLY", "status": "COMPLETED", "accumulatedFillSize": 5 } ], "protections": [], "commitments": [] },
          { "status": "CLOSED", "orders": [], "protections": [], "commitments": [] }
        ]
      },
      "expect": { "allTranchesTerminal": true, "dealRiskBearing": false, "dealExposure": 0, "exposureReconciled": true, "aggregateTransitionAllowed": true }
    },
    {
      "case": "агрегат в координированном выходе: новый риск не берётся ни одним траншем",
