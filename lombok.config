# Конфигурация Lombok монорепозитория — ОДНА на все деревья кода.
#
# ЗАЧЕМ В КОРНЕ, А НЕ В КАЖДОМ МОДУЛЕ. Lombok ищет конфигурацию вверх от
# файла-исходника до первого `config.stopBubbling`. Пока дерево кода было
# одно, конфигурация лежала в нём. С выделением libs/domain-model классы
# уехали из области действия донорской конфигурации и стали собираться с
# УМОЛЧАНИЕМ капитализации — то есть у полей вида `kPeriod` сменились
# имена аксессоров, и донор перестал компилироваться.
#
# Дефект поймала сборка, а не чтение: имя аксессора не написано ни в
# одном файле — его производит процессор. Копия конфигурации в каждом
# модуле закрыла бы случай и оставила механизм: следующий модуль снова
# уехал бы из области. Один файл в корне закрывает механизм.
config.stopBubbling = true
lombok.accessors.capitalization = beanspec
